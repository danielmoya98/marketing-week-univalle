---
// MarcadorLanding.astro — Sección de Marcador Oficial en Tiempo Real conectado a Supabase con animaciones FLIP y Empty States
---

<section
    class="sec marcador-landing-section"
    id="marcador"
    aria-labelledby="marcador-title"
>
    <!-- Retícula sutil de micropuntos deportivos de fondo -->
    <div class="marcador-bg-pattern" aria-hidden="true"></div>

    <div class="wrap" style="position: relative; z-index: 2;">
        <!-- Encabezado de la Sección -->
        <div class="marcador-header-row">
            <div class="sec-head" style="margin-bottom: 0;">
                <div class="marcador-badges-row">
                    <p class="eyebrow" style="margin: 0;">
                        Tablero oficial en vivo
                    </p>
                    <span class="badge-rubberhose">★ CLASIFICACIÓN ★</span>
                </div>

                <h2
                    class="display"
                    id="marcador-title"
                    style="margin-top: 8px;"
                >
                    EL CAMPEONATO SE DEFINE{" "}
                    <span style="color: var(--orange);">EN TIEMPO REAL.</span>
                </h2>

                <p class="sec-lead">
                    Sigue el pulso de la votación estudiantil minuto a minuto.
                    Con cada voto validado en el campus, las posiciones se
                    reordenan en directo y los equipos se disputan el liderato.
                </p>
            </div>

            <!-- Placa de información rápida con datos reales -->
            <div class="marcador-quick-info">
                <div class="quick-stat-box">
                    <span class="stat-num mono" id="totalVotesReal">
                        0
                    </span>
                    <span class="stat-lbl mono">Votos registrados</span>
                </div>
                <div class="quick-stat-box">
                    <span class="stat-num mono" id="totalTeamsReal">
                        0
                    </span>
                    <span class="stat-lbl mono">Grupos inscritos</span>
                </div>
                <div class="quick-stat-box">
                    <span class="stat-num mono" style="color: var(--orange);">
                        1
                    </span>
                    <span class="stat-lbl mono">Voto por categoría</span>
                </div>
            </div>
        </div>

        <!-- Ticker de actividad conectado a la base de datos -->
        <div class="marcador-ticker-bar" role="status" aria-live="polite">
            <span class="ticker-icon">⚡</span>
            <span class="ticker-label mono">ÚLTIMA ACTIVIDAD:</span>
            <span class="ticker-text" id="liveTickerText">
                Sistema listo · En espera de los primeros registros y votos del
                campus
            </span>
        </div>

        <!-- Contenedor del Tablero de Clasificación -->
        <div class="marcador-board-wrapper">
            <!-- Encabezado de columnas (se oculta automáticamente en empty state) -->
            <div class="board-col-headers mono" id="boardColHeaders">
                <span class="col-pos">POS</span>
                <span class="col-team">EQUIPO / LÍDER</span>
                <span class="col-bib">DORSAL</span>
                <span class="col-progress">VOTOS POPULARES</span>
                <span class="col-score">TOTAL VOTOS</span>
            </div>

            <!-- Lista reordenable con animación FLIP / Empty State dinámico -->
            <div class="board-items-container" id="landingBoardList">
                <div class="marcador-empty-state">
                    <span class="empty-icon">🏁</span>
                    <h4 class="empty-title">AÚN NO HAY EQUIPOS INSCRITOS</h4>
                    <p class="empty-desc">
                        El marcador oficial se actualizará en tiempo real con
                        cada voto validado tan pronto los grupos completen su
                        inscripción y comiencen las votaciones.
                    </p>
                    <a
                        href="/inscribir"
                        class="btn btn--orange btn--sm empty-cta"
                    >
                        Inscribir a mi grupo oficial &rarr;
                    </a>
                </div>
            </div>
        </div>

        <!-- Llamada a la Acción (CTA) oficial -->
        <div class="marcador-cta-box">
            <div class="marcador-cta-content">
                <div class="marcador-cta-badge mono">
                    <span class="star-icon">★</span>
                    <span>TU APOYO DECIDE EL CAMPEONATO</span>
                </div>
                <h3 class="marcador-cta-title display">
                    ¿QUIERES QUE TU GRUPO PARTICIPE Y OBTENGA SU QR?
                </h3>
                <p class="marcador-cta-desc">
                    Cada grupo inscrito genera automáticamente su código QR
                    oficial para imprimirlo en sus stands y banderas. Para votar
                    por tu equipo favorito, escanea su código QR con tu móvil en
                    el Campus Central.
                </p>
            </div>

            <div class="marcador-cta-actions">
                <a
                    href="/inscribir"
                    class="btn btn--orange btn--lg marcador-btn-cta"
                >
                    <span>Inscribir grupo y obtener QR</span>
                    <span class="btn-arrow">&rarr;</span>
                </a>
                <a href="/marcador" class="btn btn--ghost btn--lg">
                    <span>Ver marcador completo en pantalla</span>
                </a>
            </div>
        </div>
    </div>
</section>

<style is:global>
    /* =========================================================================
       SECCIÓN MARCADOR EN LA LANDING (MW26)
       ========================================================================= */
    .marcador-landing-section {
        position: relative;
        background: var(--paper, #efeee8);
        border-block: 1px solid var(--line, rgba(16, 16, 16, 0.14));
        overflow: hidden;
        padding-block: clamp(60px, 7vw, 100px);
        color: var(--ink, #101010);
    }

    .marcador-bg-pattern {
        position: absolute;
        inset: 0;
        pointer-events: none;
        z-index: 1;
        opacity: 0.04;
        background-image: radial-gradient(
            var(--ink, #101010) 1.5px,
            transparent 1.5px
        );
        background-size: 24px 24px;
    }

    .marcador-header-row {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 32px;
        margin-bottom: 24px;
        flex-wrap: wrap;
    }

    .marcador-badges-row {
        display: flex;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
        margin-bottom: 8px;
    }

    .live-pulse-badge {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        font-size: 0.68rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        padding: 3px 10px;
        border-radius: 999px;
        background: var(--white, #fefffa);
        border: 1px solid var(--line, rgba(16, 16, 16, 0.14));
        color: var(--ink, #101010);
        box-shadow: 0 1px 4px rgba(16, 16, 16, 0.04);
    }

    .live-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: var(--orange, #fe7b00);
        box-shadow: 0 0 0 0 rgba(254, 123, 0, 0.7);
        animation: livePulseGlow 1.8s infinite;
    }

    @keyframes livePulseGlow {
        0% {
            transform: scale(0.95);
            box-shadow: 0 0 0 0 rgba(254, 123, 0, 0.7);
        }
        70% {
            transform: scale(1.15);
            box-shadow: 0 0 0 6px rgba(254, 123, 0, 0);
        }
        100% {
            transform: scale(0.95);
            box-shadow: 0 0 0 0 rgba(254, 123, 0, 0);
        }
    }

    .marcador-quick-info {
        display: flex;
        gap: 16px;
        align-items: center;
    }

    .quick-stat-box {
        background: var(--white, #fefffa);
        border: 1px solid var(--line, rgba(16, 16, 16, 0.14));
        border-radius: 6px;
        padding: 10px 16px;
        text-align: center;
        min-width: 105px;
        box-shadow: 0 2px 6px rgba(16, 16, 16, 0.03);
    }

    .quick-stat-box .stat-num {
        display: block;
        font-size: 1.45rem;
        font-weight: 800;
        line-height: 1;
        color: var(--ink, #101010);
    }

    .quick-stat-box .stat-lbl {
        display: block;
        font-size: 0.62rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--muted, #5b5d62);
        margin-top: 4px;
    }

    /* Ticker de actividad */
    .marcador-ticker-bar {
        display: flex;
        align-items: center;
        gap: 10px;
        background: var(--white, #fefffa);
        border: 1px solid var(--line, rgba(16, 16, 16, 0.14));
        border-left: 4px solid var(--orange, #fe7b00);
        border-radius: 4px;
        padding: 10px 16px;
        margin-bottom: 20px;
        font-size: 0.82rem;
        box-shadow: 0 1px 4px rgba(16, 16, 16, 0.03);
    }

    .ticker-icon {
        color: var(--orange, #fe7b00);
        font-size: 1rem;
        line-height: 1;
    }

    .ticker-label {
        font-size: 0.68rem;
        font-weight: 800;
        letter-spacing: 0.12em;
        color: var(--orange-deep, #fe6e02);
        text-transform: uppercase;
    }

    .ticker-text {
        color: var(--ink, #101010);
        font-weight: 500;
        transition: opacity 0.25s ease;
    }

    /* Encabezado de columnas */
    .board-col-headers {
        display: grid;
        grid-template-columns: 56px 52px 64px minmax(0, 1fr) 100px;
        gap: 16px;
        align-items: center;
        padding: 10px 18px;
        font-size: 0.66rem;
        font-weight: 800;
        letter-spacing: 0.12em;
        color: var(--muted, #5b5d62);
        text-transform: uppercase;
    }

    .board-col-headers .col-score {
        text-align: right;
    }

    /* Contenedor del Tablero */
    .marcador-board-wrapper {
        background: var(--white, #fefffa);
        border: 1.5px solid var(--line, rgba(16, 16, 16, 0.14));
        border-radius: 8px;
        box-shadow: 0 4px 16px rgba(16, 16, 16, 0.05);
        overflow: hidden;
        margin-bottom: 36px;
    }

    .board-items-container {
        position: relative;
        display: flex;
        flex-direction: column;
        padding: 6px;
        gap: 6px;
        min-height: 200px;
    }

    /* Tarjeta de Cada Equipo en la Landing */
    .landing-board-card {
        position: relative;
        display: grid;
        grid-template-columns: 56px 52px 64px minmax(0, 1fr) 100px;
        gap: 16px;
        align-items: center;
        background: var(--white, #fefffa);
        border: 1px solid var(--line-soft, rgba(16, 16, 16, 0.08));
        border-radius: 6px;
        padding: 14px 18px;
        transition:
            transform 0.65s cubic-bezier(0.22, 1, 0.36, 1),
            box-shadow 0.4s ease,
            border-color 0.4s ease,
            background-color 0.3s ease;
        will-change: transform, z-index, box-shadow;
    }

    .landing-board-card:hover {
        background: rgba(254, 123, 0, 0.02);
    }

    /* EFECTO DE SOLAPAMIENTO CUANDO UN EQUIPO SUBE DE PUESTO */
    .landing-board-card.is-climbing {
        z-index: 35 !important;
        background: var(--white, #fefffa) !important;
        border-color: var(--orange, #fe7b00) !important;
        box-shadow:
            0 12px 32px rgba(254, 123, 0, 0.22),
            0 0 0 1.5px var(--orange, #fe7b00) !important;
        transform: scale(1.018);
    }

    .landing-board-card.just-voted {
        animation: votePulseRow 0.65s ease-out;
    }

    @keyframes votePulseRow {
        0% {
            background: rgba(254, 123, 0, 0.16);
        }
        100% {
            background: var(--white, #fefffa);
        }
    }

    /* Badge de Posición */
    .board-rank-badge {
        font-family: var(--f-display, sans-serif);
        font-size: 2.2rem;
        font-weight: 900;
        line-height: 1;
        color: var(--muted, #5b5d62);
        text-align: center;
        font-variant-numeric: tabular-nums;
        transition: color 0.3s ease;
    }

    .rank--1 {
        color: var(--orange, #fe7b00) !important;
    }
    .rank--2 {
        color: var(--ink, #101010) !important;
    }
    .rank--3 {
        color: var(--ink, #101010) !important;
    }

    /* Avatar / Escudo */
    .board-team-avatar {
        width: 44px;
        height: 44px;
        border-radius: 50%;
        border: 1.5px solid var(--line, rgba(16, 16, 16, 0.14));
        display: grid;
        place-items: center;
        font-family: var(--f-display, sans-serif);
        font-size: 1.15rem;
        font-weight: 900;
        color: var(--ink, #101010);
        flex-shrink: 0;
    }

    /* Dorsal */
    .board-dorsal-tag {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        height: 32px;
        padding-inline: 8px;
        border: 1px solid var(--line, rgba(16, 16, 16, 0.14));
        border-radius: 3px;
        background: var(--paper, #efeee8);
        font-size: 0.8rem;
        font-weight: 700;
        color: var(--ink, #101010);
    }

    /* Información del equipo */
    .board-team-details {
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .board-team-title-row {
        display: flex;
        align-items: baseline;
        gap: 10px;
        flex-wrap: wrap;
    }

    .board-team-name {
        font-family: var(--f-body, sans-serif);
        font-size: 1.05rem;
        font-weight: 800;
        color: var(--ink, #101010);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .board-team-leader {
        font-size: 0.72rem;
        font-weight: 600;
        color: var(--muted, #5b5d62);
    }

    /* Barra de votos populares */
    .board-vote-bar-wrap {
        width: 100%;
        height: 6px;
        background: var(--paper, #efeee8);
        border-radius: 999px;
        overflow: hidden;
    }

    .board-vote-bar-fill {
        height: 100%;
        background: var(--orange, #fe7b00);
        border-radius: 999px;
        transition: width 0.6s cubic-bezier(0.22, 1, 0.36, 1);
    }

    /* Votos numéricos */
    .board-score-col {
        text-align: right;
    }

    .board-score-number {
        font-family: var(--f-display, sans-serif);
        font-size: 2.2rem;
        font-weight: 900;
        line-height: 1;
        color: var(--ink, #101010);
        font-variant-numeric: tabular-nums;
    }

    .board-score-unit {
        display: block;
        font-size: 0.64rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        color: var(--muted, #5b5d62);
    }

    /* =========================================================================
       ESTADOS VACÍOS (EMPTY STATES)
       ========================================================================= */
    .marcador-empty-state {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 48px 24px;
        background: var(--paper, #efeee8);
        border: 1.5px dashed var(--line, rgba(16, 16, 16, 0.2));
        border-radius: 6px;
        margin: 8px;
    }

    .empty-icon {
        font-size: 2.5rem;
        display: block;
        margin-bottom: 10px;
    }

    .empty-title {
        font-family: var(--f-display, sans-serif);
        font-size: clamp(1.4rem, 2.4vw, 1.8rem);
        font-weight: 900;
        letter-spacing: 0.04em;
        color: var(--ink, #101010);
        margin: 0 0 6px 0;
    }

    .empty-desc {
        font-size: 0.9rem;
        color: var(--muted, #5b5d62);
        max-width: 480px;
        margin: 0 auto 18px;
        line-height: 1.45;
    }

    .empty-cta {
        font-weight: 700;
    }

    /* =========================================================================
       CAJA DE LLAMADA A LA ACCIÓN (CTA)
       ========================================================================= */
    .marcador-cta-box {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 36px;
        background: var(--white, #fefffa);
        border: 2px solid var(--ink, #101010);
        border-radius: 12px;
        padding: clamp(24px, 4vw, 40px);
        box-shadow: 6px 6px 0 var(--orange, #fe7b00);
        flex-wrap: wrap;
    }

    .marcador-cta-content {
        flex: 1;
        min-width: 280px;
        max-width: 680px;
    }

    .marcador-cta-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 0.72rem;
        font-weight: 800;
        letter-spacing: 0.12em;
        color: var(--orange-deep, #fe6e02);
        text-transform: uppercase;
        margin-bottom: 8px;
    }

    .marcador-cta-badge .star-icon {
        font-size: 0.9rem;
        color: var(--orange, #fe7b00);
    }

    .marcador-cta-title {
        font-size: clamp(1.8rem, 3.2vw, 2.6rem);
        font-weight: 900;
        line-height: 0.95;
        letter-spacing: 0.02em;
        color: var(--ink, #101010);
        margin-bottom: 12px;
    }

    .marcador-cta-desc {
        font-size: 0.95rem;
        line-height: 1.5;
        color: var(--muted, #5b5d62);
        margin: 0;
    }

    .marcador-cta-actions {
        display: flex;
        flex-direction: column;
        gap: 12px;
        flex-shrink: 0;
    }

    .marcador-btn-cta {
        box-shadow: 0 4px 16px rgba(254, 123, 0, 0.35);
    }

    .btn-arrow {
        transition: transform 0.2s ease;
    }

    .marcador-btn-cta:hover .btn-arrow {
        transform: translateX(4px);
    }

    /* =========================================================================
       RESPONSIVIDAD MÓVIL
       ========================================================================= */
    @media (max-width: 820px) {
        .board-col-headers {
            display: none !important;
        }

        .landing-board-card {
            grid-template-columns: 40px 42px minmax(0, 1fr) auto;
            gap: 12px;
            padding: 12px 14px;
        }

        .board-dorsal-tag {
            display: none;
        }

        .board-rank-badge {
            font-size: 1.8rem;
        }

        .board-team-avatar {
            width: 40px;
            height: 40px;
            font-size: 1rem;
        }

        .board-score-number {
            font-size: 1.8rem;
        }

        .marcador-cta-box {
            flex-direction: column;
            align-items: stretch;
            gap: 24px;
        }

        .marcador-cta-actions {
            width: 100%;
        }

        .marcador-cta-actions .btn {
            width: 100%;
            text-align: center;
            justify-content: center;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .landing-board-card {
            transition: none !important;
        }
        .live-dot {
            animation: none !important;
        }
    }
</style>

<script>
    // =========================================================================
    // INTEGRACIÓN REAL CON SUPABASE Y ANIMACIÓN FLIP DE SOLAPAMIENTO
    // =========================================================================
    import { supabase, isConfigured } from "../../lib/supabase.js";

    interface TeamData {
        id: string;
        bib: string;
        name: string;
        initials: string;
        leader: string;
        avatarBg: string;
        votes: number;
    }

    let realTeams: TeamData[] = [];
    const container = document.getElementById("landingBoardList");
    const colHeaders = document.getElementById("boardColHeaders");
    const tickerText = document.getElementById("liveTickerText");
    const totalVotesEl = document.getElementById("totalVotesReal");
    const totalTeamsEl = document.getElementById("totalTeamsReal");

    const CATEGORY_NAMES: Record<string, string> = {
        botargas: "Carrera de Botargas",
        stands: "Decoración de Stands",
        enbanderamiento: "Embanderamiento",
    };

    const esc = (t: string) =>
        String(t).replace(
            /[&<>"']/g,
            (c) =>
                ({
                    "&": "&amp;",
                    "<": "&lt;",
                    ">": "&gt;",
                    '"': "&quot;",
                    "'": "&#39;",
                })[c] || c,
        );

    function getTeamInitials(name: string): string {
        if (!name) return "MW";
        const words = name
            .trim()
            .split(/\s+/)
            .filter(
                (w) =>
                    ![
                        "los",
                        "las",
                        "el",
                        "la",
                        "de",
                        "del",
                        "en",
                        "y",
                    ].includes(w.toLowerCase()),
            );
        if (words.length === 0) return name.slice(0, 2).toUpperCase();
        if (words.length === 1) return words[0].slice(0, 2).toUpperCase();
        return (words[0][0] + words[1][0]).toUpperCase();
    }

    function getSortedTeams(): TeamData[] {
        return [...realTeams].sort((a, b) => b.votes - a.votes);
    }

    function renderCards(
        targetEl: HTMLElement,
        sortedList: TeamData[],
        justVotedId: string | null,
    ) {
        if (sortedList.length === 0) {
            if (colHeaders) colHeaders.style.display = "none";
            targetEl.innerHTML = `
        <div class="marcador-empty-state">
          <span class="empty-icon">🏁</span>
          <h4 class="empty-title">AÚN NO HAY EQUIPOS INSCRITOS</h4>
          <p class="empty-desc">
            El marcador oficial se actualizará en tiempo real con cada voto validado tan pronto los grupos completen su inscripción y comiencen las votaciones.
          </p>
          <a href="/inscribir" class="btn btn--orange btn--sm empty-cta">
            Inscribir a mi grupo oficial &rarr;
          </a>
        </div>
      `;
            return;
        }

        if (colHeaders) colHeaders.style.display = "";

        const maxVotes = Math.max(...sortedList.map((t) => t.votes), 1);

        targetEl.innerHTML = sortedList
            .map((team, index) => {
                const rank = index + 1;
                const formattedRank = rank < 10 ? "0" + rank : String(rank);
                const percent =
                    maxVotes > 0
                        ? Math.min(
                              100,
                              Math.round((team.votes / maxVotes) * 100),
                          )
                        : 0;
                const isJustVoted = team.id === justVotedId;

                return `
        <div
          class="landing-board-card ${isJustVoted ? "just-voted" : ""}"
          data-team-id="${team.id}"
          role="row"
        >
          <span class="board-rank-badge rank--${rank}">${formattedRank}</span>

          <div class="board-team-avatar" style="background: ${team.avatarBg};" aria-hidden="true">
            ${team.initials}
          </div>

          <span class="board-dorsal-tag mono">#${team.bib}</span>

          <div class="board-team-details">
            <div class="board-team-title-row">
              <strong class="board-team-name">${esc(team.name)}</strong>
              ${team.leader ? `<span class="board-team-leader mono">Líder: ${esc(team.leader)}</span>` : ""}
            </div>
            <div class="board-vote-bar-wrap">
              <div class="board-vote-bar-fill" style="width: ${percent}%;"></div>
            </div>
          </div>

          <div class="board-score-col">
            <span class="board-score-number">${team.votes}</span>
            <span class="board-score-unit mono">${team.votes === 1 ? "VOTO" : "VOTOS"}</span>
          </div>
        </div>
      `;
            })
            .join("");
    }

    // ALGORITMO FLIP CON ELEVACIÓN Y SOLAPAMIENTO DE TARJETAS
    function applyFlipReorder(votedTeamId: string | null = null) {
        if (!container) return;

        if (realTeams.length === 0) {
            renderCards(container, [], null);
            return;
        }

        // 1. FIRST: Medir posiciones verticales previas
        const firstTops = new Map<string, number>();
        container
            .querySelectorAll<HTMLElement>(".landing-board-card")
            .forEach((card) => {
                const id = card.dataset.teamId;
                if (id) {
                    firstTops.set(id, card.getBoundingClientRect().top);
                }
            });

        // 2. Ordenar datos por votos reales descendente
        const sortedList = getSortedTeams();

        // 3. Renderizar DOM en nuevo orden
        renderCards(container, sortedList, votedTeamId);

        // 4. INVERT & PLAY: Animar con solapamiento
        container
            .querySelectorAll<HTMLElement>(".landing-board-card")
            .forEach((card) => {
                const id = card.dataset.teamId;
                if (!id) return;

                const firstTop = firstTops.get(id);
                if (firstTop !== undefined) {
                    const lastTop = card.getBoundingClientRect().top;
                    const deltaY = firstTop - lastTop;

                    if (deltaY !== 0) {
                        if (deltaY > 0) {
                            // Sube de posición: solapamiento elevado
                            card.style.zIndex = "35";
                            card.classList.add("is-climbing");
                        } else {
                            card.style.zIndex = "5";
                            card.classList.remove("is-climbing");
                        }

                        card.style.transform = `translateY(${deltaY}px)`;
                        card.style.transition = "none";

                        void card.offsetHeight;

                        card.style.transition =
                            "transform 0.75s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.6s ease";
                        card.style.transform = "translateY(0)";

                        setTimeout(() => {
                            card.style.zIndex = "";
                            card.style.transform = "";
                            card.classList.remove("is-climbing");
                        }, 800);
                    }
                }
            });
    }

    // Carga de datos reales desde Supabase
    async function loadSupabaseData(changedTeamId: string | null = null) {
        try {
            if (isConfigured && supabase) {
                const { data: grupos, error: gErr } = await supabase
                    .from("grupos")
                    .select("id, nombre, lider, categorias, color")
                    .order("created_at", { ascending: true });

                const { data: votos, error: vErr } = await supabase
                    .from("votos")
                    .select("id, categoria_id, grupo_id, equipo_id, created_at")
                    .order("created_at", { ascending: false });

                if (!gErr && grupos) {
                    const voteCounts: Record<string, number> = {};

                    (votos || []).forEach((v) => {
                        const gId = v.grupo_id || v.equipo_id;
                        if (gId) {
                            voteCounts[gId] = (voteCounts[gId] || 0) + 1;
                        }
                    });

                    realTeams = grupos.map((g, idx) => ({
                        id: g.id,
                        bib: String(idx + 1).padStart(2, "0"),
                        name: g.nombre,
                        initials: getTeamInitials(g.nombre),
                        leader: g.lider || "",
                        avatarBg:
                            idx % 2 === 0
                                ? "rgba(254, 123, 0, 0.14)"
                                : "rgba(16, 16, 16, 0.08)",
                        votes: voteCounts[g.id] || 0,
                    }));

                    const totalVotesCount = votos ? votos.length : 0;
                    if (totalVotesEl)
                        totalVotesEl.textContent = String(totalVotesCount);
                    if (totalTeamsEl)
                        totalTeamsEl.textContent = String(grupos.length);

                    // Actualizar Ticker con el último voto real registrado
                    if (votos && votos.length > 0) {
                        const lastVote = votos[0];
                        const targetGroup = grupos.find(
                            (g) =>
                                g.id ===
                                (lastVote.grupo_id || lastVote.equipo_id),
                        );
                        const catName =
                            CATEGORY_NAMES[lastVote.categoria_id] ||
                            "Competencia oficial";
                        if (tickerText) {
                            const groupName = targetGroup
                                ? targetGroup.nombre
                                : "un equipo oficial";
                            tickerText.innerHTML = `Voto registrado para <strong>${esc(groupName)}</strong> en <em>${catName}</em> (+1 voto)`;
                        }
                    } else {
                        if (tickerText) {
                            tickerText.innerHTML =
                                "Sistema listo · En espera de los primeros votos del campus central";
                        }
                    }
                } else {
                    realTeams = [];
                    if (totalVotesEl) totalVotesEl.textContent = "0";
                    if (totalTeamsEl) totalTeamsEl.textContent = "0";
                }
            } else {
                realTeams = [];
            }
        } catch (e) {
            console.warn("Error cargando marcador desde Supabase:", e);
            realTeams = [];
        } finally {
            applyFlipReorder(changedTeamId);
        }
    }

    // Inicialización y Realtime
    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", () => {
            loadSupabaseData();
        });
    } else {
        loadSupabaseData();
    }

    // Suscripción a Supabase Realtime
    if (isConfigured && supabase) {
        supabase
            .channel("mw26-landing-realtime")
            .on(
                "postgres_changes",
                { event: "*", schema: "public", table: "votos" },
                (payload) => {
                    const changedTeamId =
                        (payload.new as any)?.grupo_id ||
                        (payload.new as any)?.equipo_id ||
                        null;
                    loadSupabaseData(changedTeamId);
                },
            )
            .on(
                "postgres_changes",
                { event: "*", schema: "public", table: "grupos" },
                () => {
                    loadSupabaseData();
                },
            )
            .subscribe();
    }

    // Polling de respaldo cada 20 segundos
    setInterval(() => {
        loadSupabaseData();
    }, 20000);
</script>
