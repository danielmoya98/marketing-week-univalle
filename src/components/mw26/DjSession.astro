---
// DjSession.astro — Sección dedicada al DJ en vivo y la ambientación musical de Marketing Week
import { fetchInstagramPost } from '../../lib/instagramScraper';

interface Props {
  djPostUrl?: string;
  djInstagramUrl?: string;
  djTikTokUrl?: string;
}

const {
  djPostUrl = "https://www.instagram.com/p/DeD2bguDvio/",
  djInstagramUrl = "https://www.instagram.com/soti_beats/",
  djTikTokUrl = "https://www.tiktok.com/@soti_beats"
} = Astro.props;

// Auto-lectura de la publicación oficial del DJ
const postData = await fetchInstagramPost(djPostUrl);

const djName = "SOTI BEATS DJ";
const djHandle = "@soti_beats";
const djRole = "Aliado & DJ Oficial Confirmado";
const genre = "Electronic · Tech House · Urban & Open Format";
---

<section class="sec sec--dj night" id="musica">
  <!-- Patrón de ondas de sonido y surcos de vinilo -->
  <div class="dj-bg-pattern-grooves" aria-hidden="true"></div>
  <div class="wrap" style="position:relative; z-index:2;">
    <div class="dj-shell">
      <!-- Glow ambiental de escenario -->
      <div class="dj-glow" aria-hidden="true"></div>

      <div class="dj-grid">
        <!-- Columna Izquierda: Información de la Presentación -->
        <div class="dj-info">
          <div style="display: flex; align-items: center; gap: 12px; flex-wrap: wrap; margin-bottom: 8px;">
            <div class="eyebrow" style="color: var(--orange); margin: 0;">
              <span>En vivo · Patio Central</span>
            </div>
            <span class="badge-rubberhose" style="font-size: 11px; padding: 3px 10px;">★ LIVE SET OFICIAL ★</span>
          </div>
          
          <h2 class="display dj-title">
            Música, beats <br />
            <span class="o">&amp; ambiente en vivo.</span>
          </h2>

          <p class="dj-desc">
            La energía de Marketing Week ya tiene sonido propio. Damos la bienvenida a <strong>{djName}</strong> como aliado oficial para musicalizar la feria de stands, la carrera de botargas y las activaciones universitarias.
          </p>

          <!-- Tarjeta del DJ con foto oficial y redes sociales -->
          <div class="dj-card">
            <div class="dj-avatar">
              <img 
                src={postData.image || "/img/mascot.jpg"} 
                alt={`${djName} en Marketing Week`} 
                class="dj-photo" 
                loading="lazy" 
              />
              <span class="dj-live-dot">DJ OFICIAL</span>
            </div>

            <div class="dj-meta">
              <div class="dj-badge-row">
                <span class="tag tag--orange">{djRole}</span>
                <span class="dj-genre mono">{genre}</span>
              </div>
              <h3 class="dj-name">{djName}</h3>
              <p class="dj-handle mono">{djHandle}</p>

              <!-- Enlaces a redes sociales del DJ -->
              <div class="dj-social-links">
                <a 
                  href={djInstagramUrl} 
                  target="_blank" 
                  rel="noopener noreferrer" 
                  class="dj-soc-btn dj-soc-btn--ig"
                  aria-label="Instagram de Soti Beats DJ"
                >
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                    <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                    <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
                  </svg>
                  <span>Instagram</span>
                </a>

                <a 
                  href={postData.url} 
                  target="_blank" 
                  rel="noopener noreferrer" 
                  class="dj-soc-btn dj-soc-btn--post"
                  aria-label="Ver anuncio oficial en Instagram"
                >
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                    <polyline points="15 3 21 3 21 9"></polyline>
                    <line x1="10" y1="14" x2="21" y2="3"></line>
                  </svg>
                  <span>Ver Anuncio</span>
                </a>
              </div>
            </div>
          </div>

          <!-- Horarios del Set en Vivo -->
          <div class="dj-schedule">
            <div class="dj-slot">
              <span class="dj-slot__day mono">MARTES 06 · 15:00 a 17:00</span>
              <b>Feria de Stands &amp; Activaciones</b>
              <p>Música continua durante la presentación de stands y votación popular.</p>
            </div>
            <div class="dj-slot">
              <span class="dj-slot__day mono">MIÉRCOLES 07 · 15:00 a 17:00</span>
              <b>Carrera de Botargas &amp; After-Race</b>
              <p>Beats en el circuito de obstáculos y celebración en el Patio Central.</p>
            </div>
          </div>
        </div>

        <!-- Columna Derecha: Tarima Visual & Ecualizador Dinámico -->
        <div class="dj-stage">
          <div class="dj-deck">
            <div class="dj-deck__header">
              <div class="dj-status">
                <i class="dot dot--ok"></i>
                <span class="mono">UNIVALLE SOUND SYSTEM 2026</span>
              </div>
              <span class="mono" style="color: var(--orange)">PATIO STAGE</span>
            </div>

            <!-- Visualizador de ondas / Ecualizador animado -->
            <div class="dj-visualizer" aria-hidden="true">
              <div class="bar" style="--h: 65%; --d: 0.12s"></div>
              <div class="bar" style="--h: 90%; --d: 0.35s"></div>
              <div class="bar" style="--h: 45%; --d: 0.18s"></div>
              <div class="bar" style="--h: 80%; --d: 0.42s"></div>
              <div class="bar" style="--h: 100%; --d: 0.25s"></div>
              <div class="bar" style="--h: 55%; --d: 0.5s"></div>
              <div class="bar" style="--h: 85%; --d: 0.3s"></div>
              <div class="bar" style="--h: 70%; --d: 0.15s"></div>
              <div class="bar" style="--h: 95%; --d: 0.4s"></div>
              <div class="bar" style="--h: 60%; --d: 0.28s"></div>
              <div class="bar" style="--h: 75%; --d: 0.32s"></div>
              <div class="bar" style="--h: 90%; --d: 0.48s"></div>
              <div class="bar" style="--h: 50%; --d: 0.22s"></div>
              <div class="bar" style="--h: 80%; --d: 0.38s"></div>
            </div>

            <!-- Tarjeta Visual de Marki Valle DJ -->
            <div class="dj-mascot-spotlight">
              <img src="/assets/img/marki-valle-dj.jpg" alt="Marki Valle DJ animando Marketing Week" class="dj-mascot-pic" />
              <div class="dj-mascot-caption">
                <span class="badge-rubberhose" style="font-size: 10px; padding: 2px 8px;">★ MARKI ON THE DECKS ★</span>
                <b class="font-cartoon" style="font-size: 1.05rem; color: #fff; display: block; margin-top: 4px;">BEATS &amp; ENERGÍA EN VIVO</b>
                <p style="font-size: 0.8rem; color: #A4A6AB; margin: 4px 0 0; line-height: 1.4;">
                  "{postData.caption.replace(/View all comments.*/i, '').trim().slice(0, 130)}..."
                </p>
              </div>
            </div>

            <div class="dj-deck__cta">
              <a class="btn btn--orange btn--sm" href={djInstagramUrl} target="_blank" rel="noopener noreferrer">
                Seguir a Soti Beats en IG &rarr;
              </a>
              <span class="mono" style="font-size: 11px; color: #A4A6AB">Patio Central · Entrada libre</span>
            </div>
          </div>
        </div>
    </div>
  </div>
</section>

<style>
  .dj-bg-pattern-grooves {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 1;
    opacity: 0.04;
    background-image: repeating-radial-gradient(
      circle at 80% 30%,
      rgba(255, 122, 0, 0.7) 0,
      rgba(255, 122, 0, 0.7) 2px,
      transparent 2px,
      transparent 26px
    );
  }
</style>
