---
// CampusMap.astro — Mapa ilustrado con pines interactivos y acordeón de zonas
---
<section class="sec sec--alt" id="mapa">
  <div class="wrap">
    <div class="sec-head">
      <p class="eyebrow">Mapa de ubicaciones</p>
      <h2 class="display">El terreno de juego.</h2>
      <p class="sec-lead">
        El Campus Central se transforma en el epicentro de la estrategia. Toca un punto del mapa o una zona de la lista para ver qué ocurre, cuándo y dónde.
      </p>
    </div>
    <div class="map">
      <figure class="map__plate">
        <div class="map__stage" id="mapStage">
          <img src="/img/campus.jpg" width="768" height="508" alt="Mapa ilustrado del Campus Central de Univalle" loading="lazy" />
        </div>
        <figcaption class="map__cap">Campus Central Univalle · Acceso libre comunidad universitaria</figcaption>
      </figure>
      <div class="map__side-col">
        <div class="map-explorer-card">
          <img src="/assets/img/marki-valle-map.jpg" alt="Marki Valle con el mapa del campus" class="map-explorer-img" />
          <div class="map-explorer-info">
            <span class="badge-rubberhose" style="font-size: 10px; padding: 2px 8px;">★ GUÍA DE ZONAS ★</span>
            <b class="font-cartoon" style="font-size: 1.05rem; color: var(--ink); display: block; margin-top: 4px;">EXPLORA EL CAMPUS CENTRAL</b>
            <p style="font-size: 0.8rem; color: var(--muted); margin: 4px 0 0; line-height: 1.4;">
              Sigue a Marki Valle para ubicar las 3 zonas clave de competencia y no perderte ninguna actividad.
            </p>
          </div>
        </div>
        <div class="zones" id="zones"></div>
      </div>
    </div>
  </div>
</section>

<script>
  const ZONES = [
    {
      n: '01', k: 'El Patio', x: 49, y: 44,
      title: 'El Patio Central',
      sub: 'Feria de stands y carrera de botargas',
      desc: 'El corazón al aire libre de Marketing Week. Aquí cada equipo monta su stand oficial con activaciones interactivas para captar votos, y se instala el circuito de obstáculos para la carrera de botargas.',
      f: [
        ['Días clave', 'Martes 06 y miércoles 07'],
        ['Horarios', '08:30 a 12:30 · 15:00 a 17:00'],
        ['Actividad', 'Votación masiva, música en vivo y corredores']
      ],
      cta: 'Votar desde tu móvil',
      href: '#marcador'
    },
    {
      n: '02', k: 'E-Zone', x: 67, y: 25,
      title: 'La E-Zone',
      sub: 'Gran ceremonia de premiación y clausura',
      desc: 'El espacio cubierto donde se anuncian los resultados del marcador oficial y donde se entregan los trofeos el jueves, con autoridades académicas y el campus presente.',
      f: [
        ['Día clave', 'Jueves 08'],
        ['Horario', '10:30 a 12:00'],
        ['Actividad', 'Cierre oficial, premiación de campeones y celebración']
      ],
      cta: 'Ver el fixture completo',
      href: '#programa'
    },
    {
      n: '03', k: 'Control', x: 38, y: 72,
      title: 'Mesa de control',
      sub: 'Acreditación y atención a grupos',
      desc: 'El punto de entrada del campus. Aquí los grupos confirman su asistencia, resuelven dudas con la organización y se coordina el trabajo con el comité.',
      f: [
        ['Días clave', 'Lunes 05 a jueves 08'],
        ['Horarios', 'Desde las 08:00'],
        ['Actividad', 'Acreditación, dudas y atención al jurado']
      ],
      cta: 'Inscribir a mi grupo',
      href: '#inscripcion'
    }
  ];

  let selZone = 0;

  function initZones() {
    const zonesContainer = document.getElementById('zones');
    const st = document.getElementById('mapStage');
    if (!zonesContainer || !st) return;

    // Renderizar los pines en el mapa
    st.querySelectorAll('.pin').forEach(p => p.remove());
    ZONES.forEach((z, i) => {
      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'pin';
      b.style.left = `${z.x}%`;
      b.style.top = `${z.y}%`;
      b.setAttribute('aria-pressed', String(i === selZone));
      b.setAttribute('aria-label', `Zona ${z.n}: ${z.k}`);
      b.innerHTML = `<span class="pin__n">${z.n}</span><span class="pin__l">${z.k}</span>`;
      b.addEventListener('click', () => {
        selectZone(i);
      });
      st.appendChild(b);
    });

    // Renderizar estructura persistente para permitir transiciones suaves
    zonesContainer.innerHTML = ZONES.map((z, i) => {
      const on = i === selZone;
      return `
        <div class="zn${on ? ' is-on' : ''}" data-zone="${i}">
          <button type="button" class="zn__h" aria-expanded="${on}" aria-controls="zb${i}" data-i="${i}">
            <b>${z.n}</b>
            <span>
              <span class="zt">${z.title}</span>
              <span class="s">${z.sub}</span>
            </span>
          </button>
          <div class="zn__collapse" id="zb${i}">
            <div class="zn__b">
              <p>${z.desc}</p>
              <dl class="facts">
                ${z.f.map(r => `<div><dt>${r[0]}</dt><dd>${r[1]}</dd></div>`).join('')}
              </dl>
              <div><a class="btn btn--sm" href="${z.href}">${z.cta}</a></div>
            </div>
          </div>
        </div>
      `;
    }).join('');

    zonesContainer.querySelectorAll<HTMLButtonElement>('.zn__h').forEach(b => {
      b.addEventListener('click', () => {
        const idx = +(b.getAttribute('data-i') || 0);
        selectZone(idx);
      });
    });
  }

  function selectZone(index: number) {
    selZone = index;
    const st = document.getElementById('mapStage');
    const zonesContainer = document.getElementById('zones');
    if (!st || !zonesContainer) return;

    // Actualizar pines
    st.querySelectorAll<HTMLButtonElement>('.pin').forEach((pin, i) => {
      pin.setAttribute('aria-pressed', String(i === selZone));
    });

    // Actualizar acordeones sin destruir el DOM
    zonesContainer.querySelectorAll<HTMLElement>('.zn').forEach((zn, i) => {
      const isOn = i === selZone;
      zn.classList.toggle('is-on', isOn);
      const btn = zn.querySelector<HTMLButtonElement>('.zn__h');
      if (btn) btn.setAttribute('aria-expanded', String(isOn));
    });
  }

  initZones();
</script>
