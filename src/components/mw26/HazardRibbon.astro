---
// HazardRibbon.astro — Cinta horizontal animada minimalista oficial Marketing Week 2026
// Basada estrictamente en la referencia visual: [Mascota Marki] MARKETING WEEK | UNIVALLE
interface Props {
  variant?: 'brand' | 'minimal' | 'paper' | 'orange';
  angle?: number;
  speedSeconds?: number;
}

const {
  variant = 'brand',
  angle = 0,
  speedSeconds = 24
} = Astro.props;

// Lista repetida para alimentar la tira continua sin cortes
const REPEATS = Array.from({ length: 8 });
---

<div 
  class={`mw-ribbon-bar mw-ribbon-bar--${variant}`} 
  style={`--ribbon-angle: ${angle}deg; --scroll-speed: ${speedSeconds}s;`}
  role="region"
  aria-label="Cinta oficial de Marketing Week Univalle"
>
  <div class="mw-ribbon-track">
    <!-- Grupo 1 -->
    <div class="mw-ribbon-group">
      {REPEATS.map(() => (
        <div class="mw-ribbon-item">
          <img 
            src="/assets/img/mascot-marquee.png" 
            alt="Mascota Marki" 
            class="mw-ribbon-mascot"
            width="32"
            height="32"
            loading="lazy"
            decoding="async"
          />
          <span class="mw-ribbon-text-marketing">MARKETING</span>
          <span class="mw-ribbon-text-week">WEEK</span>
          <span class="mw-ribbon-pipe" aria-hidden="true">|</span>
          <span class="mw-ribbon-text-univalle">UNIVALLE</span>
        </div>
      ))}
    </div>

    <!-- Grupo 2 (Clon idéntico para continuidad infinita sin saltos) -->
    <div class="mw-ribbon-group" aria-hidden="true">
      {REPEATS.map(() => (
        <div class="mw-ribbon-item">
          <img 
            src="/assets/img/mascot-marquee.png" 
            alt="" 
            class="mw-ribbon-mascot"
            width="32"
            height="32"
            loading="lazy"
            decoding="async"
          />
          <span class="mw-ribbon-text-marketing">MARKETING</span>
          <span class="mw-ribbon-text-week">WEEK</span>
          <span class="mw-ribbon-pipe" aria-hidden="true">|</span>
          <span class="mw-ribbon-text-univalle">UNIVALLE</span>
        </div>
      ))}
    </div>
  </div>
</div>

<style is:global>
  /* Contenedor principal de la cinta: SIEMPRE blanco marfil con bordes finos, salvo si se pide explícitamente orange */
  .mw-ribbon-bar {
    width: 100% !important;
    position: relative !important;
    overflow: hidden !important;
    background: #FEFFFA !important;
    border-top: 1px solid rgba(16, 16, 16, 0.14) !important;
    border-bottom: 1px solid rgba(16, 16, 16, 0.14) !important;
    padding-top: 12px !important;
    padding-bottom: 12px !important;
    transform: rotate(var(--ribbon-angle, 0deg)) !important;
    user-select: none !important;
    z-index: 20 !important;
    box-shadow: 0 1px 4px rgba(16, 16, 16, 0.02) !important;
    cursor: default !important;
  }

  /* Variante sobre fondo papel si se requiere */
  .mw-ribbon-bar--paper {
    background: #EFEEE8 !important;
  }

  /* Variante naranja SOLO si se especifica explícitamente variant="orange" */
  .mw-ribbon-bar--orange {
    background: #FE7B00 !important;
    border-top: 1px solid rgba(16, 16, 16, 0.18) !important;
    border-bottom: 1px solid rgba(16, 16, 16, 0.18) !important;
  }
  .mw-ribbon-bar--orange .mw-ribbon-text-marketing {
    color: #101010 !important;
  }
  .mw-ribbon-bar--orange .mw-ribbon-text-week {
    color: #FEFFFA !important;
  }
  .mw-ribbon-bar--orange .mw-ribbon-pipe {
    color: rgba(16, 16, 16, 0.3) !important;
  }
  .mw-ribbon-bar--orange .mw-ribbon-text-univalle {
    color: rgba(16, 16, 16, 0.65) !important;
  }

  /* Riel animado continuo */
  .mw-ribbon-track {
    display: flex !important;
    flex-direction: row !important;
    flex-wrap: nowrap !important;
    align-items: center !important;
    width: max-content !important;
    animation: mwRibbonScroll var(--scroll-speed, 24s) linear infinite !important;
    will-change: transform !important;
  }

  .mw-ribbon-bar:hover .mw-ribbon-track {
    animation-play-state: paused !important;
  }

  @keyframes mwRibbonScroll {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  /* Grupo de elementos: NUNCA romper línea, estrictamente horizontal */
  .mw-ribbon-group {
    display: inline-flex !important;
    flex-direction: row !important;
    flex-wrap: nowrap !important;
    align-items: center !important;
    flex-shrink: 0 !important;
    white-space: nowrap !important;
  }

  /* Cada unidad: [Mascota] MARKETING WEEK | UNIVALLE */
  .mw-ribbon-item {
    display: inline-flex !important;
    flex-direction: row !important;
    flex-wrap: nowrap !important;
    align-items: center !important;
    padding-left: 0 !important;
    padding-right: clamp(36px, 3.5vw, 56px) !important;
    white-space: nowrap !important;
    flex-shrink: 0 !important;
  }

  /* Mascota Marki */
  .mw-ribbon-mascot {
    width: 32px !important;
    height: 32px !important;
    object-fit: contain !important;
    display: inline-block !important;
    margin-right: 12px !important;
    flex-shrink: 0 !important;
    vertical-align: middle !important;
    filter: drop-shadow(0 1px 2px rgba(16, 16, 16, 0.08)) !important;
    transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1) !important;
  }

  .mw-ribbon-bar:hover .mw-ribbon-mascot {
    transform: scale(1.18) rotate(4deg) !important;
  }

  /* MARKETING (Negro carbón sólido) */
  .mw-ribbon-text-marketing {
    font-family: var(--f-display, 'Anton', sans-serif) !important;
    font-size: clamp(1.2rem, 1.45vw, 1.4rem) !important;
    font-weight: 900 !important;
    letter-spacing: 0.04em !important;
    text-transform: uppercase !important;
    color: #101010 !important;
    line-height: 1 !important;
    display: inline-block !important;
    margin-right: 6px !important;
    vertical-align: middle !important;
  }

  /* WEEK (Naranja insignia vibrante #FE7B00) */
  .mw-ribbon-text-week {
    font-family: var(--f-display, 'Anton', sans-serif) !important;
    font-size: clamp(1.2rem, 1.45vw, 1.4rem) !important;
    font-weight: 900 !important;
    letter-spacing: 0.04em !important;
    text-transform: uppercase !important;
    color: #FE7B00 !important;
    line-height: 1 !important;
    display: inline-block !important;
    vertical-align: middle !important;
  }

  /* Separador | (Gris suave) */
  .mw-ribbon-pipe {
    display: inline-block !important;
    color: rgba(16, 16, 16, 0.25) !important;
    font-size: 1.15rem !important;
    font-weight: 300 !important;
    margin-left: 14px !important;
    margin-right: 14px !important;
    line-height: 1 !important;
    vertical-align: middle !important;
    user-select: none !important;
  }

  /* UNIVALLE (Monospace suave en gris claro) */
  .mw-ribbon-text-univalle {
    display: inline-block !important;
    font-family: var(--f-mono, 'Space Mono', monospace) !important;
    font-size: clamp(0.72rem, 0.85vw, 0.82rem) !important;
    font-weight: 600 !important;
    letter-spacing: 0.22em !important;
    text-transform: uppercase !important;
    color: rgba(16, 16, 16, 0.40) !important;
    line-height: 1 !important;
    vertical-align: middle !important;
  }

  @media (prefers-reduced-motion: reduce) {
    .mw-ribbon-track {
      animation: none !important;
      overflow-x: auto !important;
    }
  }
</style>
