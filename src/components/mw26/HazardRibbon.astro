---
// HazardRibbon.astro — Cinta horizontal animada minimalista y deportiva para Marketing Week 2026
export type RibbonVariant = 'minimal' | 'pills' | 'clean-mono' | 'bold';

interface Props {
  variant?: RibbonVariant;
  angle?: number;
  speedSeconds?: number;
}

const {
  variant = 'minimal',
  angle = 0,
  speedSeconds = 26
} = Astro.props;

// Lista concisa de elementos informativos (limpios y sin sobrecarga de texto)
const SLICES = [
  { title: "MARKETING WEEK 2026", detail: "UNIVALLE CAMPUS CENTRAL", tag: "OFICIAL" },
  { title: "VOTACIÓN EN VIVO", detail: "1 VOTO POR CATEGORÍA", tag: "REALTIME" },
  { title: "05 — 08 OCTUBRE", detail: "3 COMPETENCIAS EN PISTA", tag: "FIXTURE" },
  { title: "IDENTIDAD & ESTRATEGIA", detail: "COMUNIDAD ESTUDIANTIL", tag: "UNIVALLE" }
];
---

<div 
  class={`ribbon-container ribbon-container--${variant}`} 
  style={`--ribbon-angle: ${angle}deg; --scroll-speed: ${speedSeconds}s;`}
  role="region"
  aria-label="Cinta animada de novedades oficiales"
>
  <div class="ribbon-track">
    <!-- Grupo 1 -->
    <div class="ribbon-group">
      {variant === 'minimal' && (
        SLICES.map((s) => (
          <div class="ribbon-slice ribbon-slice--minimal">
            <span class="ribbon-star">✦</span>
            <span class="ribbon-title">{s.title}</span>
            <span class="ribbon-separator">·</span>
            <span class="ribbon-detail mono">{s.detail}</span>
          </div>
        ))
      )}

      {variant === 'pills' && (
        SLICES.map((s) => (
          <div class="ribbon-pill-item">
            <span class="ribbon-pill">
              <span class="ribbon-pill__dot"></span>
              <strong class="ribbon-pill__title">{s.title}</strong>
              <span class="ribbon-pill__tag mono">{s.tag}</span>
            </span>
          </div>
        ))
      )}

      {variant === 'clean-mono' && (
        SLICES.map((s) => (
          <div class="ribbon-slice ribbon-slice--clean-mono">
            <span class="ribbon-diamond">◆</span>
            <span class="ribbon-mono-text mono">
              <strong>{s.title}</strong> <span class="ribbon-mono-accent">[{s.detail}]</span>
            </span>
          </div>
        ))
      )}

      {variant === 'bold' && (
        SLICES.map((s) => (
          <div class="ribbon-slice ribbon-slice--bold">
            <span class="ribbon-star-lg">★</span>
            <span class="ribbon-title-lg">{s.title}</span>
            <span class="ribbon-badge-sub mono">{s.detail}</span>
          </div>
        ))
      )}
    </div>

    <!-- Grupo 2 (Clon idéntico para continuidad infinita sin saltos) -->
    <div class="ribbon-group" aria-hidden="true">
      {variant === 'minimal' && (
        SLICES.map((s) => (
          <div class="ribbon-slice ribbon-slice--minimal">
            <span class="ribbon-star">✦</span>
            <span class="ribbon-title">{s.title}</span>
            <span class="ribbon-separator">·</span>
            <span class="ribbon-detail mono">{s.detail}</span>
          </div>
        ))
      )}

      {variant === 'pills' && (
        SLICES.map((s) => (
          <div class="ribbon-pill-item">
            <span class="ribbon-pill">
              <span class="ribbon-pill__dot"></span>
              <strong class="ribbon-pill__title">{s.title}</strong>
              <span class="ribbon-pill__tag mono">{s.tag}</span>
            </span>
          </div>
        ))
      )}

      {variant === 'clean-mono' && (
        SLICES.map((s) => (
          <div class="ribbon-slice ribbon-slice--clean-mono">
            <span class="ribbon-diamond">◆</span>
            <span class="ribbon-mono-text mono">
              <strong>{s.title}</strong> <span class="ribbon-mono-accent">[{s.detail}]</span>
            </span>
          </div>
        ))
      )}

      {variant === 'bold' && (
        SLICES.map((s) => (
          <div class="ribbon-slice ribbon-slice--bold">
            <span class="ribbon-star-lg">★</span>
            <span class="ribbon-title-lg">{s.title}</span>
            <span class="ribbon-badge-sub mono">{s.detail}</span>
          </div>
        ))
      )}
    </div>
  </div>
</div>

<style is:global>
  .ribbon-container {
    width: 100%;
    position: relative;
    overflow: hidden;
    transform: rotate(var(--ribbon-angle, 0deg));
    user-select: none;
    z-index: 20;
    pointer-events: none;
  }

  .ribbon-track {
    display: flex;
    width: max-content;
    animation: ribbonScroll var(--scroll-speed, 26s) linear infinite;
    will-change: transform;
  }

  .ribbon-container:hover .ribbon-track {
    animation-play-state: paused;
  }

  @keyframes ribbonScroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  .ribbon-group {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  /* =========================================================================
     VARIANTE 1: MINIMAL (Cinta deportiva naranja limpia y esbelta - Recomendada)
     ========================================================================= */
  .ribbon-container--minimal {
    background: var(--orange, #FE7B00);
    color: var(--ink, #101010);
    border-block: 1px solid var(--line, rgba(16, 16, 16, 0.14));
    padding-block: 10px;
    box-shadow: 0 4px 14px rgba(254, 123, 0, 0.16);
  }

  .ribbon-slice--minimal {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    padding-inline: 22px;
    white-space: nowrap;
  }

  .ribbon-star {
    color: var(--ink, #101010);
    font-size: 1.1rem;
    line-height: 1;
    opacity: 0.85;
  }

  .ribbon-title {
    font-family: var(--f-display, sans-serif);
    font-size: clamp(1.25rem, 1.8vw, 1.55rem);
    font-weight: 900;
    letter-spacing: 0.05em;
    line-height: 1;
    text-transform: uppercase;
    color: var(--ink, #101010);
  }

  .ribbon-separator {
    color: var(--ink, #101010);
    font-weight: 900;
    opacity: 0.45;
  }

  .ribbon-detail {
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink, #101010);
    opacity: 0.88;
  }

  /* =========================================================================
     VARIANTE 2: PILLS (Cápsulas deportivas flotantes sobre papel)
     ========================================================================= */
  .ribbon-container--pills {
    background: var(--paper, #EFEEE8);
    border-block: 1px solid var(--line, rgba(16, 16, 16, 0.14));
    padding-block: 12px;
  }

  .ribbon-pill-item {
    display: inline-flex;
    align-items: center;
    padding-inline: 8px;
    white-space: nowrap;
  }

  .ribbon-pill {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: var(--white, #FEFFFA);
    border: 1.5px solid var(--line, rgba(16, 16, 16, 0.14));
    border-radius: 999px;
    padding: 8px 18px;
    box-shadow: 0 2px 8px rgba(16, 16, 16, 0.04);
    transition: border-color 0.2s ease;
  }

  .ribbon-pill__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--orange, #FE7B00);
    flex-shrink: 0;
  }

  .ribbon-pill__title {
    font-family: var(--f-display, sans-serif);
    font-size: 1.15rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink, #101010);
    line-height: 1;
  }

  .ribbon-pill__tag {
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    padding: 2px 7px;
    border-radius: 4px;
    background: var(--orange-soft, #FFCB8A);
    color: var(--ink, #101010);
    text-transform: uppercase;
  }

  /* =========================================================================
     VARIANTE 3: CLEAN-MONO (Estilo suizo minimalista sobre blanco marfil)
     ========================================================================= */
  .ribbon-container--clean-mono {
    background: var(--white, #FEFFFA);
    border-block: 1px solid var(--line, rgba(16, 16, 16, 0.14));
    padding-block: 12px;
  }

  .ribbon-slice--clean-mono {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    padding-inline: 24px;
    white-space: nowrap;
  }

  .ribbon-diamond {
    color: var(--orange, #FE7B00);
    font-size: 0.85rem;
    line-height: 1;
  }

  .ribbon-mono-text {
    font-size: 0.82rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink, #101010);
  }

  .ribbon-mono-text strong {
    font-weight: 800;
  }

  .ribbon-mono-accent {
    color: var(--orange-deep, #FE6E02);
    font-weight: 600;
    margin-left: 4px;
  }

  /* =========================================================================
     VARIANTE 4: BOLD (Titular deportivo de alto impacto)
     ========================================================================= */
  .ribbon-container--bold {
    background: var(--orange, #FE7B00);
    color: var(--ink, #101010);
    border-block: 2px solid var(--ink, #101010);
    padding-block: 12px;
  }

  .ribbon-slice--bold {
    display: inline-flex;
    align-items: center;
    gap: 16px;
    padding-inline: 28px;
    white-space: nowrap;
  }

  .ribbon-star-lg {
    font-size: 1.3rem;
    line-height: 1;
    color: var(--ink, #101010);
  }

  .ribbon-title-lg {
    font-family: var(--f-display, sans-serif);
    font-size: clamp(1.8rem, 2.6vw, 2.3rem);
    font-weight: 900;
    letter-spacing: 0.04em;
    line-height: 0.9;
    text-transform: uppercase;
    color: var(--ink, #101010);
  }

  .ribbon-badge-sub {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    padding: 3px 9px;
    border-radius: 3px;
    background: var(--ink, #101010);
    color: var(--white, #FEFFFA);
    text-transform: uppercase;
  }
</style>
