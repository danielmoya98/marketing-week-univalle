---
// Aliados.astro — Sección de marcas aliadas oficiales con carrusel infinito horizontal
interface Aliado {
  name: string;
  logo: string;
  category: string;
}

const aliados: Aliado[] = [
  {
    name: "San Gabriel",
    logo: "/assets/img/aliados/aliado-san-gabriel.png",
    category: "Alimentos & Panadería Oficial",
  },
  {
    name: "Carsa",
    logo: "/assets/img/aliados/aliado-carsa.png",
    category: "Equipamiento & Servicios",
  },
  {
    name: "La Bifería",
    logo: "/assets/img/aliados/aliado-la-biferia.png",
    category: "Cortes & Parrilla",
  },
  {
    name: "Soti Beats",
    logo: "/assets/img/aliados/aliado-soti-beats.png",
    category: "DJ Oficial & Producción",
  },
  {
    name: "Vicio",
    logo: "/assets/img/aliados/aliado-vicio.png",
    category: "Hamburguesas & Alitas",
  },
  {
    name: "Okis Market",
    logo: "/assets/img/aliados/aliado-okis-market.png",
    category: "Market & Conveniencia",
  },
  {
    name: "Porky's",
    logo: "/assets/img/aliados/aliado-porkys.png",
    category: "Hamburguesas & Street Food",
  },
  {
    name: "MALABA",
    logo: "/assets/img/aliados/aliado-malaba.png",
    category: "Moda & Streetwear",
  },
  {
    name: "San Agustín",
    logo: "/assets/img/aliados/aliado-san-agustin.png",
    category: "Salud & Servicios",
  },
  {
    name: "Fadi's",
    logo: "/assets/img/aliados/aliado-fadis.png",
    category: "Gastronomía & Snacks",
  },
  {
    name: "Season 21",
    logo: "/assets/img/aliados/aliado-season-21.png",
    category: "Moda & Concept Store",
  },
  {
    name: "El Sultan",
    logo: "/assets/img/aliados/aliado-el-sultan.png",
    category: "Gastronomía & Cafetería",
  },
  {
    name: "Scafry",
    logo: "/assets/img/aliados/aliado-scafry.png",
    category: "Gastronomía Española & Mediterránea",
  },
  {
    name: "MOPS Barber Studio",
    logo: "/assets/img/aliados/aliado-mops-barber.png",
    category: "Barber Studio by Soti Beats",
  },
  {
    name: "FANCESA",
    logo: "/assets/img/aliados/aliado-fancesa.png",
    category: "Industria & Construcción",
  },
  {
    name: "Chop Chop",
    logo: "/assets/img/aliados/aliado-chop-chop.png",
    category: "Sabor Oriental & Gastronomía",
  },
  {
    name: "Electronics Store",
    logo: "/assets/img/aliados/aliado-electronics-store.png",
    category: "Tecnología & Gadgets",
  },
  {
    name: "Frida",
    logo: "/assets/img/aliados/aliado-frida.png",
    category: "Moda & Tendencias",
  },
  {
    name: "Indrä Market",
    logo: "/assets/img/aliados/aliado-indra-market.png",
    category: "Market & Variedades",
  },
  {
    name: "Hangar",
    logo: "/assets/img/aliados/aliado-hangar.png",
    category: "Moda & Concept Store",
  },
  {
    name: "Abolengo",
    logo: "/assets/img/aliados/aliado-abolengo.png",
    category: "Gastronomía & Entretenimiento",
  },
  {
    name: "Alejandra Barzón",
    logo: "/assets/img/aliados/aliado-alejandra-barzon.png",
    category: "Alta Costura & Diseño",
  },
  {
    name: "Azafrán",
    logo: "/assets/img/aliados/aliado-azafran.png",
    category: "Gastronomía & Café",
  },
  {
    name: "TEC alim S.A.",
    logo: "/assets/img/aliados/aliado-tec-alim.png",
    category: "Tecnología en Alimentos",
  },
];

// Repetimos 2 veces en cada grupo para asegurar continuidad fluida en cualquier pantalla
const trackItems = [...aliados, ...aliados];
---

<section class="sec sec--aliados night" id="aliados">
  <div class="wrap">
    <div class="aliados-head">
      <div style="display: flex; align-items: center; gap: 12px; flex-wrap: wrap; margin-bottom: 8px;">
        <span class="eyebrow" style="color: var(--orange); margin: 0;">Sponsors &amp; Marcas Oficiales</span>
        <span class="badge-rubberhose" style="font-size: 11px; padding: 3px 10px;">★ ALIANZAS CONFIRMADAS ★</span>
      </div>

      <h2 class="display aliados-title">
        Nuestros <span class="o">Aliados</span> del Campeonato.
      </h2>

      <p class="aliados-lead">
        Marcas líderes que se unen con energía, premios y activaciones para toda la comunidad universitaria de Univalle durante Marketing Week 2026.
      </p>
    </div>
  </div>

  <!-- Carrusel Infinito Horizontal -->
  <div class="aliados-carousel-wrap">
    <div class="aliados-track" aria-label="Marcas aliadas oficiales de Marketing Week 2026">
      <!-- Grupo 1 -->
      <div class="aliados-group">
        {trackItems.map((aliado) => (
          <div class="aliado-card" title={`${aliado.name} — ${aliado.category}`}>
            <img 
              src={aliado.logo} 
              alt={`Logo oficial de ${aliado.name}`} 
              class="aliado-img" 
              loading="lazy" 
            />
          </div>
        ))}
      </div>

      <!-- Grupo 2 (Duplicado para continuidad infinita sin cortes) -->
      <div class="aliados-group" aria-hidden="true">
        {trackItems.map((aliado) => (
          <div class="aliado-card" title={`${aliado.name} — ${aliado.category}`}>
            <img 
              src={aliado.logo} 
              alt="" 
              class="aliado-img" 
              loading="lazy" 
            />
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- Barra de enlace / Convocatoria de aliados -->
  <div class="wrap">
    <div class="aliados-cta-bar">
      <div class="aliados-cta-text">
        <span class="mono" style="color: var(--orange); font-size: 0.72rem; letter-spacing: 0.12em; text-transform: uppercase; font-weight: 700;">
          ¿Quieres sumar tu marca a Marketing Week?
        </span>
        <p>Participa con activaciones en la feria de stands, entrega de premios oficiales y presencia en el marcador en vivo.</p>
      </div>
      <a 
        href="https://www.instagram.com/marketing_week_univallesucre/" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="btn btn--ghost btn--sm"
      >
        <span>Ser Aliado Oficial</span>
        <span style="color: var(--orange); margin-left: 4px;">&rarr;</span>
      </a>
    </div>
  </div>
</section>

<style>
  .sec--aliados {
    position: relative;
    overflow: clip;
    padding-block: clamp(48px, 6vw, 84px);
    background: #0B0C0E;
    border-top: 1px solid rgba(244, 243, 239, 0.08);
    border-bottom: 1px solid rgba(244, 243, 239, 0.08);
  }

  .aliados-head {
    max-width: 68ch;
  }

  .aliados-title {
    font-size: clamp(2.2rem, 5vw, 4rem);
    margin-top: 10px;
    text-transform: uppercase;
  }

  .aliados-title .o {
    color: var(--orange);
  }

  .aliados-lead {
    margin: 14px 0 28px;
    color: #C9CACD;
    font-size: 1.02rem;
    line-height: 1.6;
  }

  /* Contenedor del bucle horizontal infinito */
  .aliados-carousel-wrap {
    width: 100%;
    overflow: hidden;
    position: relative;
    padding: 16px 0 28px;
    mask-image: linear-gradient(to right, transparent, #000 8%, #000 92%, transparent);
    -webkit-mask-image: linear-gradient(to right, transparent, #000 8%, #000 92%, transparent);
  }

  .aliados-track {
    display: flex;
    width: max-content;
    will-change: transform;
    animation: aliadosMarquee 68s linear infinite;
  }

  .aliados-carousel-wrap:hover .aliados-track {
    animation-play-state: paused;
  }

  .aliados-group {
    display: flex;
    align-items: center;
    gap: 20px;
    padding-right: 20px;
  }

  @keyframes aliadosMarquee {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  /* Tarjeta de cada logo de aliado */
  .aliado-card {
    display: flex;
    align-items: center;
    justify-content: center;
    background: #FFFFFF;
    border-radius: 12px;
    padding: 14px 28px;
    height: 82px;
    min-width: 175px;
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.45), inset 0 1px 0 rgba(255, 255, 255, 0.9);
    border: 1px solid rgba(255, 255, 255, 0.18);
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
    user-select: none;
    flex-shrink: 0;
  }

  .aliado-card:hover {
    transform: translateY(-3px) scale(1.025);
    box-shadow: 0 10px 26px rgba(255, 122, 0, 0.22);
    border-color: var(--orange);
  }

  .aliado-img {
    max-height: 52px;
    max-width: 135px;
    width: auto;
    height: auto;
    object-fit: contain;
    display: block;
    transition: transform 0.25s ease;
  }

  .aliado-card:hover .aliado-img {
    transform: scale(1.04);
  }

  /* Barra de llamado de patrocinio inferior */
  .aliados-cta-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(244, 243, 239, 0.1);
    border-left: 4px solid var(--orange);
    padding: 18px 24px;
    border-radius: 6px;
    margin-top: 14px;
    flex-wrap: wrap;
  }

  .aliados-cta-text p {
    font-size: 0.9rem;
    color: #A4A6AB;
    margin: 4px 0 0;
    line-height: 1.45;
  }

  /* Responsividad móvil */
  @media (max-width: 720px) {
    .aliados-carousel-wrap {
      padding: 12px 0 20px;
      mask-image: linear-gradient(to right, transparent, #000 4%, #000 96%, transparent);
      -webkit-mask-image: linear-gradient(to right, transparent, #000 4%, #000 96%, transparent);
    }

    .aliados-track {
      animation-duration: 44s;
    }

    .aliados-group {
      gap: 14px;
      padding-right: 14px;
    }

    .aliado-card {
      height: 70px;
      min-width: 140px;
      padding: 10px 18px;
      border-radius: 10px;
    }

    .aliado-img {
      max-height: 42px;
      max-width: 108px;
    }

    .aliados-cta-bar {
      flex-direction: column;
      align-items: flex-start;
      padding: 16px;
      gap: 14px;
    }

    .aliados-cta-bar .btn {
      width: 100%;
      text-align: center;
      justify-content: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .aliados-track {
      animation-duration: 90s;
    }
  }
</style>
