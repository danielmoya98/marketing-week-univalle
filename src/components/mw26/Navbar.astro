---
// Navbar.astro — Barra de navegación principal y selector de tema
---
<header class="nav night">
  <div class="wrap nav__in">
    <a class="logo" href="#inicio">
      <img src="/img/logo-mw26.png" width="36" height="36" alt="Logo oficial Marketing Week 2026" class="logo__emblem" />
      <span>Marketing Week</span>
    </a>
    
    <nav class="nav__links" aria-label="Secciones">
      <a href="#programa">Fixture</a>
      <a href="#mapa">Mapa</a>
      <a href="#competencias">Competencias</a>
      <a href="#premios">Premios</a>
      <a href="#musica">Música</a>
      <a href="#comunidad">Comunidad</a>
      <a href="#faq">Preguntas</a>
    </nav>

    <div class="nav__right">
      <button class="icon-btn" id="themeBtn" type="button" aria-label="Cambiar entre tema claro y oscuro">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
          <circle cx="12" cy="12" r="9"/>
          <path d="M12 3a9 9 0 0 1 0 18z" fill="currentColor"/>
        </svg>
      </button>
      <a class="btn btn--orange btn--sm nav-btn-inscribir" href="/inscribir">
        <span class="btn-inscribir-full">Inscribir grupo</span>
        <span class="btn-inscribir-short">Inscribir</span>
      </a>
    </div>
  </div>
</header>

<style>
  .btn-inscribir-short {
    display: none;
  }
  @media (max-width: 640px) {
    .nav-btn-inscribir {
      padding: 6px 12px !important;
      font-size: 0.72rem !important;
      white-space: nowrap;
    }
    .btn-inscribir-full {
      display: none;
    }
    .btn-inscribir-short {
      display: inline;
    }
  }
</style>

<script>
  const themeBtn = document.getElementById('themeBtn');
  if (themeBtn) {
    themeBtn.addEventListener('click', () => {
      const root = document.documentElement;
      const current = root.getAttribute('data-theme');
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      const isDark = current === 'dark' || (!current && prefersDark);
      const nextTheme = isDark ? 'light' : 'dark';
      
      root.setAttribute('data-theme', nextTheme);
      localStorage.setItem('mw26_theme', nextTheme);
    });
  }

  // Efecto dinámico de blur al hacer scroll
  const navEl = document.querySelector('.nav');
  function handleNavScroll() {
    if (navEl) {
      navEl.classList.toggle('is-scrolled', window.scrollY > 15);
    }
  }
  window.addEventListener('scroll', handleNavScroll, { passive: true });
  handleNavScroll();
</script>
