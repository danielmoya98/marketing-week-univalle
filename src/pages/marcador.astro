---
// marcador.astro — Página dedicada del Marcador Oficial en Tiempo Real para Marketing Week 2026
import LayoutMW26 from "../layouts/LayoutMW26.astro";
import TopBar from "../components/mw26/TopBar.astro";
---

<LayoutMW26 title="Marcador Oficial en Vivo — Marketing Week 2026">
    <!-- 1. Barra Superior con Fechas y Contexto -->
    <TopBar />

    <!-- 2. Header de Navegación Oficial MW26 -->
    <header class="nav">
        <div class="wrap nav__in">
            <a class="logo" href="/">
                <img
                    src="/img/logo-mw26.png"
                    width="36"
                    height="36"
                    alt="Logo oficial Marketing Week 2026"
                    class="logo__emblem"
                />
                <span>Marketing Week</span>
            </a>

            <nav class="nav__links" aria-label="Navegación del evento">
                <a href="/#programa">Fixture</a>
                <a href="/#mapa">Mapa</a>
                <a href="/#competencias">Competencias</a>
                <a href="/#premios">Premios</a>
                <a
                    href="/marcador"
                    class="is-active"
                    style="color:var(--orange);"
                >
                    Marcador
                </a>
            </nav>

            <div class="nav__right">
                <a class="btn btn--orange btn--sm" href="/inscribir">
                    Inscribir grupo
                </a>
            </div>
        </div>
    </header>

    <main
        class="sec"
        style="background: var(--paper); color: var(--ink); padding-top: clamp(36px, 5vw, 64px); position: relative; overflow: hidden;"
    >
        <!-- Marca de agua de fondo -->
        <div
            class="hero-bg-num"
            aria-hidden="true"
            style="position: absolute; right: 2%; top: 0; font: 900 clamp(8rem, 20vw, 16rem)/.8 var(--f-display); color: var(--ink); opacity: 0.035; pointer-events: none; user-select: none;"
        >
            26
        </div>

        <div class="wrap" style="position: relative; z-index: 2;">
            <!-- Hero de Marcador -->
            <div class="marcador-editorial-head">
                <div
                    class="sec-head"
                    style="margin-bottom: 24px; max-width: 850px;"
                >
                    <div style="display: flex; align-items: center; gap: 12px; flex-wrap: wrap;">
                        <p class="eyebrow" style="margin: 0;">
                            Univalle · Tablero en vivo
                        </p>
                        <span class="badge-rubberhose">
                            ★ CLASIFICACIÓN OFICIAL POR CATEGORÍAS ★
                        </span>
                        <span class="lv">
                            <i class="dot dot--ok"></i>Supabase Realtime
                        </span>
                    </div>
                    <h1
                        class="display"
                        style="font-size: clamp(2.8rem, 6.4vw, 5.2rem); margin: 0; line-height: 0.92;"
                    >
                        TABLERO Y CLASIFICACIÓN{" "}
                        <span style="color: var(--orange);">
                            EN TIEMPO REAL
                        </span>
                    </h1>
                    <p class="sec-lead" style="margin: 0;">
                        Seguimiento en directo de los ganadores por categoría.
                        Selecciona la competencia para ver las posiciones
                        oficiales en tiempo real.
                    </p>
                </div>

                <div class="marcador-plate-card">
                    <div class="plate">
                        <div class="plate__back"></div>
                        <div class="plate__img">
                            <img
                                src="/assets/img/marki-valle-official.png"
                                width="220"
                                height="260"
                                alt="Marki Valle Mascota Oficial MW26"
                                style="background: #fff; object-fit: contain; width: 100%; height: auto;"
                            />
                        </div>
                        <span
                            class="badge-rubberhose plate__tag"
                            style="position: absolute; right: 0; top: -10px; font-size: 10px; padding: 3px 10px;"
                        >
                            ⚙️ MARKI VALLE
                        </span>
                    </div>
                </div>
            </div>

            <!-- Selector de Categorías ÚNICAMENTE (Sin opción de General) -->
            <div
                class="chips"
                role="group"
                aria-label="Filtrar categoría"
                style="margin-bottom: 32px;"
            >
                <button
                    type="button"
                    class="chip"
                    data-filter="enbanderamiento"
                >
                    🚩 Embanderamiento (19/10)
                </button>
                <button type="button" class="chip" data-filter="stands">
                    🎪 Decoración de Stands (20/10)
                </button>
                <button type="button" class="chip" data-filter="botargas">
                    🏃 Carrera de Botargas (21/10)
                </button>
            </div>

            <!-- Podio Oficial Top 3 en vivo por Categoría -->
            <section class="podium-section" aria-label="Podio de líderes">
                <div class="podium-grid" id="podiumContainer">
                    <!-- 2° Lugar (Plata) -->
                    <div class="card podium-card podium-card--2">
                        <div class="podium-card-top">
                            <span
                                class="tag"
                                style="background: rgba(148,163,184,0.15); border-color: rgba(148,163,184,0.3); color: var(--ink);"
                            >
                                🥈 2° LUGAR
                            </span>
                            <span
                                class="mono"
                                style="font-size: 0.76rem; font-weight: 700; color: var(--muted);"
                                id="pod2Bib"
                            >
                                #--
                            </span>
                        </div>
                        <div
                            class="avatar podium-avatar av-silver"
                            id="pod2Avatar"
                        >
                            —
                        </div>
                        <h3 class="podium-team-title display" id="pod2Name">
                            En disputa
                        </h3>
                        <div class="podium-score-container">
                            <span class="podium-score-label mono">
                                VOTOS EN ESTA CATEGORÍA
                            </span>
                            <div class="podium-score-val-wrap">
                                <span
                                    class="podium-score-val display"
                                    id="pod2Score"
                                >
                                    0
                                </span>
                                <span class="podium-score-unit mono">
                                    VOTOS
                                </span>
                            </div>
                        </div>
                        <span class="mono podium-award-pill">
                            🥈 Subcampeón · Plata
                        </span>
                    </div>

                    <!-- 1° Lugar (Oro) -->
                    <div class="card podium-card podium-card--1 is-champion">
                        <span class="podium-crown">👑</span>
                        <div class="podium-card-top">
                            <span
                                class="tag tag--demo"
                                style="background: var(--orange); color: var(--ink); border-color: var(--orange);"
                            >
                                🥇 1° LUGAR · LÍDER
                            </span>
                            <span
                                class="mono"
                                style="font-size: 0.76rem; font-weight: 700; color: var(--orange);"
                                id="pod1Bib"
                            >
                                #--
                            </span>
                        </div>
                        <div
                            class="avatar podium-avatar av-gold"
                            id="pod1Avatar"
                        >
                            —
                        </div>
                        <h3
                            class="podium-team-title display title-gold"
                            id="pod1Name"
                        >
                            En disputa
                        </h3>
                        <div class="podium-score-container score-gold">
                            <span class="podium-score-label mono">
                                VOTOS EN ESTA CATEGORÍA
                            </span>
                            <div class="podium-score-val-wrap">
                                <span
                                    class="podium-score-val display gold-val"
                                    id="pod1Score"
                                >
                                    0
                                </span>
                                <span class="podium-score-unit mono unit-gold">
                                    VOTOS
                                </span>
                            </div>
                        </div>
                        <span class="mono podium-award-pill pill-gold">
                            ★ Ganador de Categoría ★
                        </span>
                    </div>

                    <!-- 3° Lugar (Bronce) -->
                    <div class="card podium-card podium-card--3">
                        <div class="podium-card-top">
                            <span
                                class="tag"
                                style="background: rgba(245,158,11,0.15); border-color: rgba(245,158,11,0.3); color: var(--ink);"
                            >
                                🥉 3° LUGAR
                            </span>
                            <span
                                class="mono"
                                style="font-size: 0.76rem; font-weight: 700; color: var(--muted);"
                                id="pod3Bib"
                            >
                                #--
                            </span>
                        </div>
                        <div
                            class="avatar podium-avatar av-bronze"
                            id="pod3Avatar"
                        >
                            —
                        </div>
                        <h3 class="podium-team-title display" id="pod3Name">
                            En disputa
                        </h3>
                        <div class="podium-score-container">
                            <span class="podium-score-label mono">
                                VOTOS EN ESTA CATEGORÍA
                            </span>
                            <div class="podium-score-val-wrap">
                                <span
                                    class="podium-score-val display"
                                    id="pod3Score"
                                >
                                    0
                                </span>
                                <span class="podium-score-unit mono">
                                    VOTOS
                                </span>
                            </div>
                        </div>
                        <span class="mono podium-award-pill">
                            🥉 3° Puesto · Bronce
                        </span>
                    </div>
                </div>
            </section>

            <!-- Tabla Animada de Posiciones -->
            <div class="board-layout-container">
                <div class="card panel board-main-panel">
                    <div class="panel__top">
                        <div>
                            <h2
                                class="display"
                                id="activeCategoryTitle"
                                style="font-size: clamp(1.8rem, 3.6vw, 2.5rem); margin: 0 0 8px 0; line-height: 1.1;"
                            >
                                Embanderamiento
                            </h2>
                            <p
                                class="mono"
                                style="font-size: 0.74rem; color: var(--muted); margin: 0;"
                                id="activeCategorySub"
                            >
                                Gana el equipo con mayor número de votos en esta
                                categoría · Actualización en tiempo real
                            </p>
                        </div>
                        <div style="display: flex; gap: 12px; align-items: center; flex-wrap: wrap;">
                            <span class="tag tag--demo">Datos oficiales</span>
                            <span class="lv">
                                <i class="dot dot--ok"></i>En vivo
                            </span>
                        </div>
                    </div>

                    <!-- Filas Oficiales MW26 -->
                    <div class="rows animated-board-list" id="leaderboardList">
                        <!-- Las filas de equipos se renderizan dinámicamente aquí -->
                    </div>
                </div>
            </div>
        </div>
    </main>
</LayoutMW26>

<style>
    /* Cabecera Editorial Marcador MW26 */
    .marcador-editorial-head {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 260px;
        gap: clamp(24px, 4vw, 56px);
        align-items: center;
        margin-bottom: clamp(32px, 4vw, 48px);
    }

    @media (max-width: 860px) {
        .marcador-editorial-head {
            grid-template-columns: minmax(0, 1fr);
        }
        .marcador-plate-card {
            max-width: 240px;
            margin: 0 auto;
        }
    }

    .marcador-plate-card {
        position: relative;
        display: flex;
        justify-content: center;
    }

    /* Píldoras Selectoras de Categoría */
    .chips {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-bottom: 32px;
    }

    .chip.active {
        background: var(--ink);
        color: var(--white);
        border-color: var(--ink);
    }

    /* Podio Oficial Top 3 en Vivo */
    .podium-section {
        margin-bottom: clamp(36px, 5vw, 56px);
    }

    .podium-grid {
        display: grid;
        grid-template-columns: 1fr 1.15fr 1fr;
        gap: 16px;
        align-items: end;
    }

    @media (max-width: 860px) {
        .podium-grid {
            grid-template-columns: minmax(0, 1fr);
            align-items: stretch;
        }
    }

    .podium-card {
        padding: clamp(20px, 2.5vw, 28px) clamp(16px, 2vw, 24px);
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        position: relative;
        transition:
            transform 0.3s ease,
            border-color 0.3s ease;
    }

    .podium-card:hover {
        transform: translateY(-4px);
        border-color: var(--ink);
    }

    .podium-card--1 {
        order: 2;
        min-height: 380px;
        border-top: 3px solid var(--orange);
        background: var(--surface);
    }

    .podium-card--2 {
        order: 1;
        min-height: 330px;
        background: var(--surface);
    }

    .podium-card--3 {
        order: 3;
        min-height: 310px;
        background: var(--surface);
    }

    @media (max-width: 860px) {
        .podium-card--1 {
            order: 1;
            min-height: auto;
        }
        .podium-card--2 {
            order: 2;
            min-height: auto;
        }
        .podium-card--3 {
            order: 3;
            min-height: auto;
        }
    }

    .podium-crown {
        font-size: 2rem;
        position: absolute;
        top: -20px;
        filter: drop-shadow(0 2px 6px rgba(255, 122, 0, 0.4));
    }

    .podium-card-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        width: 100%;
        margin-bottom: 16px;
    }

    .podium-avatar {
        width: 56px;
        height: 56px;
        min-width: 56px;
        min-height: 56px;
        aspect-ratio: 1 / 1;
        border-radius: 50%;
        border: 1px solid var(--rule);
        display: grid;
        place-items: center;
        font: 900 1.35rem/1 var(--f-display);
        margin-bottom: 12px;
        background: repeating-linear-gradient(
            45deg,
            var(--paper-2) 0 4px,
            var(--surface) 4px 8px
        );
        color: var(--ink);
        flex-shrink: 0;
    }

    .av-gold {
        width: 64px;
        height: 64px;
        min-width: 64px;
        min-height: 64px;
        aspect-ratio: 1 / 1;
        font-size: 1.6rem;
        border-color: var(--orange);
        color: var(--orange);
        background: rgba(255, 122, 0, 0.08);
    }

    .av-silver {
        border-color: var(--rule);
    }

    .av-bronze {
        border-color: var(--rule);
    }

    .podium-team-title {
        font: 800 clamp(1.3rem, 2vw, 1.7rem)/1.1 var(--f-display);
        text-transform: uppercase;
        color: var(--ink);
        margin: 0 0 12px;
        min-height: 2.2em;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .title-gold {
        color: var(--orange-ink, var(--ink));
    }

    .podium-score-container {
        width: 100%;
        padding: 10px 14px;
        border: 1px solid var(--rule);
        border-radius: 4px;
        background: var(--paper-2);
        margin-bottom: 14px;
    }

    .score-gold {
        border-color: rgba(255, 122, 0, 0.4);
        background: rgba(255, 122, 0, 0.05);
    }

    .podium-score-label {
        display: block;
        font: 700 0.6rem/1 var(--f-mono);
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--muted);
        margin-bottom: 4px;
    }

    .podium-score-val-wrap {
        display: flex;
        align-items: baseline;
        justify-content: center;
        gap: 6px;
    }

    .podium-score-val {
        font: 900 2.5rem/1 var(--f-display);
        color: var(--ink);
    }

    .gold-val {
        color: var(--orange);
        font-size: 3rem;
    }

    .podium-score-unit {
        font: 700 0.74rem/1 var(--f-mono);
        color: var(--muted);
    }

    .podium-award-pill {
        font: 700 0.68rem/1 var(--f-mono);
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--muted);
        padding: 6px 12px;
        border: 1px solid var(--rule);
        border-radius: 2px;
        margin-top: auto;
    }

    .pill-gold {
        color: var(--orange-ink, var(--orange));
        border-color: var(--orange);
        background: rgba(255, 122, 0, 0.08);
    }

    /* Panel Principal de la Tabla */
    .board-layout-container {
        width: 100%;
    }

    .board-main-panel {
        width: 100%;
    }

    :global(.animated-board-list) {
        position: relative;
        display: grid;
        margin-top: 14px;
        min-height: 260px;
    }

    :global(.board-empty-state) {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 48px 20px;
        background: var(--paper, #efeee8);
        border: 1.5px dashed var(--line, rgba(16, 16, 16, 0.2));
        border-radius: 8px;
        margin: 14px 0 24px;
    }

    :global(.leader-card-item) {
        display: grid !important;
        grid-template-columns: 44px 44px 54px minmax(0, 1fr) auto !important;
        gap: 16px;
        align-items: center;
        padding: 16px 8px !important;
        border-top: 1px solid var(--rule) !important;
        background: transparent;
        transition:
            transform 0.65s cubic-bezier(0.22, 1, 0.36, 1),
            background-color 0.3s ease,
            box-shadow 0.4s ease;
        will-change: transform, z-index;
    }

    :global(.leader-card-item:hover) {
        background: rgba(255, 122, 0, 0.03);
    }

    :global(.leader-card-item.is-climbing) {
        background: var(--surface) !important;
        border-top: 1px solid var(--orange) !important;
        border-bottom: 1px solid var(--orange) !important;
        box-shadow:
            0 10px 28px rgba(0, 0, 0, 0.1),
            0 0 0 1px var(--orange) !important;
        z-index: 25 !important;
        transform: scale(1.015);
    }

    :global(.leader-card-item.just-voted) {
        animation: mwPulse 0.6s ease-out;
    }

    @keyframes mwPulse {
        0% {
            transform: scale(1);
        }
        40% {
            transform: scale(1.02);
        }
        100% {
            transform: scale(1);
        }
    }

    :global(.board-rk-badge) {
        font: 900 2.2rem/1 var(--f-display);
        color: var(--muted);
        text-align: center;
        font-variant-numeric: tabular-nums;
    }

    :global(.rk-top-1) {
        color: var(--orange) !important;
    }
    :global(.rk-top-2) {
        color: var(--ink) !important;
    }
    :global(.rk-top-3) {
        color: var(--ink) !important;
    }

    :global(.board-avatar-initials) {
        width: 44px;
        height: 44px;
        border-radius: 50%;
        border: 1px solid var(--rule);
        background: repeating-linear-gradient(
            45deg,
            var(--paper-2) 0 4px,
            var(--surface) 4px 8px
        );
        display: grid;
        place-items: center;
        font: 900 1.1rem/1 var(--f-display);
        color: var(--ink);
        flex-shrink: 0;
    }

    :global(.board-bib-tag) {
        width: 52px;
        height: 36px;
        border: 1px solid var(--rule);
        border-radius: 2px;
        display: grid;
        place-items: center;
        font: 700 0.84rem/1 var(--f-mono);
        color: var(--muted);
    }

    :global(.board-team-info) {
        display: grid;
        gap: 8px;
        min-width: 0;
    }

    :global(.board-team-name-row) {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 12px;
    }

    :global(.board-team-name) {
        font-weight: 700;
        font-size: 1.05rem;
        color: var(--ink);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    :global(.board-meta-tag) {
        font: 700 0.65rem/1 var(--f-mono);
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--muted);
    }

    :global(.board-track-bar) {
        height: 6px;
        background: var(--paper-2);
        border-radius: 2px;
        overflow: hidden;
    }

    :global(.board-track-fill) {
        height: 100%;
        background: var(--orange);
        transition: width 0.6s cubic-bezier(0.22, 1, 0.36, 1);
    }

    :global(.board-row-actions) {
        display: flex;
        align-items: center;
        justify-content: flex-end;
    }

    :global(.board-score-val) {
        font: 900 2.4rem/1 var(--f-display);
        color: var(--ink);
        text-align: right;
        min-width: 60px;
        line-height: 1;
        font-variant-numeric: tabular-nums;
    }

    @media (max-width: 640px) {
        :global(.leader-card-item) {
            grid-template-columns: 32px 38px minmax(0, 1fr) auto !important;
            gap: 10px;
        }
        :global(.board-bib-tag) {
            display: none;
        }
        :global(.board-avatar-initials) {
            width: 38px;
            height: 38px;
            font-size: 0.95rem;
        }
        :global(.board-score-val) {
            font-size: 1.8rem;
            min-width: 44px;
        }
    }
</style>

<script>
    import { supabase, isConfigured } from "../lib/supabase.js";

    const esc = (t: string) =>
        String(t).replace(
            /[&<>"']/g,
            (c) =>
                ({
                    "&": "&amp;",
                    "<": "&lt;",
                    ">": "&gt;",
                    '"': "&quot;",
                    "'": "&#39;",
                })[c] || c,
        );

    interface TeamBoardData {
        id: string;
        bib: string;
        name: string;
        leader?: string;
        categories: string[];
        votes: {
            botargas: number;
            stands: number;
            enbanderamiento: number;
        };
    }

    // Detectar la categoría del día actual automáticamente
    function getDefaultCategoryByDate(): string {
        const urlParams = new URLSearchParams(window.location.search);
        const urlDateParam = urlParams.get("fecha");

        const now = new Date();
        const day = String(now.getDate()).padStart(2, "0");
        const month = String(now.getMonth() + 1).padStart(2, "0");
        const year = now.getFullYear();
        const currentDateStr = urlDateParam || `${day}/${month}/${year}`;

        if (currentDateStr.startsWith("20/10")) {
            return "stands";
        } else if (currentDateStr.startsWith("21/10")) {
            return "botargas";
        }
        // 19/10 o por defecto en días previos
        return "enbanderamiento";
    }

    let teamsData: TeamBoardData[] = [];
    let currentFilter = getDefaultCategoryByDate();

    function calculateTeamScore(t: TeamBoardData, filter: string): number {
        return t.votes[filter as keyof typeof t.votes] || 0;
    }

    function updateBoardWithAnimation(changedTeamId: string | null = null) {
        const container = document.getElementById("leaderboardList");
        if (!container) return;

        // 1. Position measurement
        const firstPositions = new Map<string, number>();
        container
            .querySelectorAll<HTMLElement>(".leader-card-item")
            .forEach((card) => {
                const id = card.dataset.teamId;
                if (id)
                    firstPositions.set(id, card.getBoundingClientRect().top);
            });

        // 2. Filtrar únicamente los equipos inscritos en la categoría activa
        const filteredTeams = teamsData.filter(
            (t) => t.categories && t.categories.includes(currentFilter),
        );

        const sortedList = filteredTeams
            .map((t) => ({
                ...t,
                calculatedScore: calculateTeamScore(t, currentFilter),
            }))
            .sort((a, b) => b.calculatedScore - a.calculatedScore);

        // Actualizar Podio
        updatePodium(sortedList);

        // 3. Renderizar DOM
        renderCardsDOM(container, sortedList, changedTeamId);

        // 4. Animación FLIP
        container
            .querySelectorAll<HTMLElement>(".leader-card-item")
            .forEach((card) => {
                const id = card.dataset.teamId;
                if (!id) return;

                const firstTop = firstPositions.get(id);
                if (firstTop !== undefined) {
                    const lastTop = card.getBoundingClientRect().top;
                    const deltaY = firstTop - lastTop;

                    if (deltaY !== 0) {
                        if (deltaY > 0) {
                            card.style.zIndex = "20";
                            card.classList.add("is-climbing");
                        } else {
                            card.style.zIndex = "2";
                            card.classList.remove("is-climbing");
                        }

                        card.style.transform = `translateY(${deltaY}px)`;
                        card.style.transition = "none";
                        card.offsetHeight;

                        card.style.transition =
                            "transform 0.75s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.75s ease, z-index 0.75s ease";
                        card.style.transform = "translateY(0)";

                        setTimeout(() => {
                            card.style.zIndex = "";
                            card.classList.remove("is-climbing");
                        }, 800);
                    }
                }
            });
    }

    function getTeamInitials(name: string): string {
        if (!name) return "MW";
        const words = name
            .trim()
            .split(/\s+/)
            .filter(
                (w) =>
                    ![
                        "los",
                        "las",
                        "el",
                        "la",
                        "de",
                        "del",
                        "en",
                        "y",
                    ].includes(w.toLowerCase()),
            );
        if (words.length === 0) return name.slice(0, 2).toUpperCase();
        if (words.length === 1) return words[0].slice(0, 2).toUpperCase();
        return (words[0][0] + words[1][0]).toUpperCase();
    }

    function renderCardsDOM(
        container: HTMLElement,
        sortedList: Array<TeamBoardData & { calculatedScore: number }>,
        changedTeamId: string | null,
    ) {
        if (sortedList.length === 0) {
            container.innerHTML = `
        <div class="board-empty-state">
          <span style="font-size: 2.4rem; display: block; margin-bottom: 8px;">🏁</span>
          <h3 class="display" style="font-size: 1.7rem; text-transform: uppercase; margin-bottom: 6px;">Sin grupos en esta categoría</h3>
          <p style="font-size: 0.9rem; color: var(--muted); max-width: 440px; margin: 0 auto 16px;">
            Aún no hay votos o grupos participando en la categoría de ${getCategoryTitle(currentFilter)}.
          </p>
          <a href="/inscribir" class="btn btn--orange btn--sm">Inscribir grupo oficial &rarr;</a>
        </div>
      `;
            return;
        }

        const maxScore = Math.max(
            ...sortedList.map((x) => x.calculatedScore),
            1,
        );

        container.innerHTML = sortedList
            .map((item, index) => {
                const rk = index + 1;
                const rkClass =
                    rk === 1
                        ? "rk-top-1"
                        : rk === 2
                          ? "rk-top-2"
                          : rk === 3
                            ? "rk-top-3"
                            : "";
                const percent =
                    maxScore > 0
                        ? Math.min(
                              100,
                              Math.round(
                                  (item.calculatedScore / maxScore) * 100,
                              ),
                          )
                        : 0;
                const isJustVoted = item.id === changedTeamId;
                const initials = getTeamInitials(item.name);
                const formattedRk = rk < 10 ? "0" + rk : String(rk);

                return `
        <div class="row leader-card-item ${isJustVoted ? "just-voted" : ""}" data-team-id="${item.id}">
          <span class="board-rk-badge ${rkClass}">${formattedRk}</span>
          <div class="board-avatar-initials" title="${esc(item.name)}">${initials}</div>
          <span class="board-bib-tag">#${esc(item.bib)}</span>
          <div class="board-team-info">
            <div class="board-team-name-row">
              <strong class="board-team-name">${esc(item.name)}</strong>
              <span class="board-meta-tag">🔥 ${item.calculatedScore} ${item.calculatedScore === 1 ? "voto" : "votos"}</span>
            </div>
            <div class="board-track-bar">
              <div class="board-track-fill" style="width: ${percent}%;"></div>
            </div>
          </div>
          <div class="board-row-actions">
            <span class="board-score-val">${item.calculatedScore}</span>
          </div>
        </div>
      `;
            })
            .join("");
    }

    function updatePodium(
        sortedList: Array<TeamBoardData & { calculatedScore: number }>,
    ) {
        const p1Bib = document.getElementById("pod1Bib");
        const p1Name = document.getElementById("pod1Name");
        const p1Score = document.getElementById("pod1Score");
        const p1Avatar = document.getElementById("pod1Avatar");

        const p2Bib = document.getElementById("pod2Bib");
        const p2Name = document.getElementById("pod2Name");
        const p2Score = document.getElementById("pod2Score");
        const p2Avatar = document.getElementById("pod2Avatar");

        const p3Bib = document.getElementById("pod3Bib");
        const p3Name = document.getElementById("pod3Name");
        const p3Score = document.getElementById("pod3Score");
        const p3Avatar = document.getElementById("pod3Avatar");

        if (sortedList[0]) {
            if (p1Bib) p1Bib.textContent = `#${sortedList[0].bib}`;
            if (p1Name) p1Name.textContent = sortedList[0].name;
            if (p1Score)
                p1Score.textContent = String(sortedList[0].calculatedScore);
            if (p1Avatar)
                p1Avatar.textContent = getTeamInitials(sortedList[0].name);
        } else {
            if (p1Bib) p1Bib.textContent = "#--";
            if (p1Name) p1Name.textContent = "En disputa";
            if (p1Score) p1Score.textContent = "0";
            if (p1Avatar) p1Avatar.textContent = "—";
        }

        if (sortedList[1]) {
            if (p2Bib) p2Bib.textContent = `#${sortedList[1].bib}`;
            if (p2Name) p2Name.textContent = sortedList[1].name;
            if (p2Score)
                p2Score.textContent = String(sortedList[1].calculatedScore);
            if (p2Avatar)
                p2Avatar.textContent = getTeamInitials(sortedList[1].name);
        } else {
            if (p2Bib) p2Bib.textContent = "#--";
            if (p2Name) p2Name.textContent = "En disputa";
            if (p2Score) p2Score.textContent = "0";
            if (p2Avatar) p2Avatar.textContent = "—";
        }

        if (sortedList[2]) {
            if (p3Bib) p3Bib.textContent = `#${sortedList[2].bib}`;
            if (p3Name) p3Name.textContent = sortedList[2].name;
            if (p3Score)
                p3Score.textContent = String(sortedList[2].calculatedScore);
            if (p3Avatar)
                p3Avatar.textContent = getTeamInitials(sortedList[2].name);
        } else {
            if (p3Bib) p3Bib.textContent = "#--";
            if (p3Name) p3Name.textContent = "En disputa";
            if (p3Score) p3Score.textContent = "0";
            if (p3Avatar) p3Avatar.textContent = "—";
        }
    }

    function getCategoryTitle(catId: string): string {
        const titlesMap: Record<string, string> = {
            enbanderamiento: "Embanderamiento",
            stands: "Decoración de Stands",
            botargas: "Carrera de Botargas",
        };
        return titlesMap[catId] || catId;
    }

    async function fetchSupabaseData(changedTeamId: string | null = null) {
        try {
            if (isConfigured && supabase) {
                const { data: gruposData, error: gErr } = await supabase
                    .from("grupos")
                    .select("id, nombre, lider, categorias, color")
                    .order("created_at", { ascending: true });

                const { data: votosData, error: vErr } = await supabase
                    .from("votos")
                    .select("id, categoria_id, equipo_id, grupo_id");

                if (!gErr && gruposData && gruposData.length > 0) {
                    const voteCounts: Record<
                        string,
                        Record<string, number>
                    > = {};

                    (votosData || []).forEach((v) => {
                        const gId = v.grupo_id || v.equipo_id;
                        if (!gId) return;
                        if (!voteCounts[gId])
                            voteCounts[gId] = {
                                botargas: 0,
                                stands: 0,
                                enbanderamiento: 0,
                            };
                        if (
                            v.categoria_id &&
                            voteCounts[gId][v.categoria_id] !== undefined
                        ) {
                            voteCounts[gId][v.categoria_id] += 1;
                        }
                    });

                    teamsData = gruposData.map((g, idx) => {
                        const gVotes = voteCounts[g.id] || {
                            botargas: 0,
                            stands: 0,
                            enbanderamiento: 0,
                        };
                        const bibNum = String(idx + 1).padStart(2, "0");

                        return {
                            id: g.id,
                            bib: bibNum,
                            name: g.nombre,
                            leader: g.lider,
                            categories: g.categorias || [],
                            votes: gVotes,
                        };
                    });
                } else {
                    teamsData = [];
                }
            } else {
                teamsData = [];
            }
        } catch (err) {
            console.warn("Operando con datos cacheados:", err);
            teamsData = [];
        } finally {
            updateBoardWithAnimation(changedTeamId);
        }
    }

    // Configuración de los botones de pestaña
    const filterChips =
        document.querySelectorAll<HTMLButtonElement>(".chips .chip");

    function syncActiveChipUI() {
        filterChips.forEach((btn) => {
            const cat = btn.getAttribute("data-filter");
            if (cat === currentFilter) {
                btn.classList.add("active");
                btn.setAttribute("aria-pressed", "true");
            } else {
                btn.classList.remove("active");
                btn.removeAttribute("aria-pressed");
            }
        });

        const titleEl = document.getElementById("activeCategoryTitle");
        if (titleEl) titleEl.textContent = getCategoryTitle(currentFilter);
    }

    filterChips.forEach((btn) => {
        btn.addEventListener("click", () => {
            currentFilter =
                btn.getAttribute("data-filter") || "enbanderamiento";
            syncActiveChipUI();
            updateBoardWithAnimation();
        });
    });

    // Inicialización
    syncActiveChipUI();
    updateBoardWithAnimation();
    fetchSupabaseData();

    // Supabase Realtime
    if (isConfigured && supabase) {
        supabase
            .channel("mw26-live-marcador")
            .on(
                "postgres_changes",
                { event: "*", schema: "public", table: "votos" },
                (payload) => {
                    const changedTeamId =
                        (payload.new as any)?.grupo_id ||
                        (payload.new as any)?.equipo_id ||
                        null;
                    fetchSupabaseData(changedTeamId);
                },
            )
            .on(
                "postgres_changes",
                { event: "*", schema: "public", table: "grupos" },
                () => {
                    fetchSupabaseData();
                },
            )
            .subscribe();
    }

    // Polling de respaldo cada 25s
    setInterval(() => {
        fetchSupabaseData();
    }, 25000);
</script>
