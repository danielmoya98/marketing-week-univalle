---
// inscribir.astro — Página oficial dedicada a la inscripción de equipos para Marketing Week 2026
import LayoutMW26 from '../layouts/LayoutMW26.astro';
import TopBar from '../components/mw26/TopBar.astro';
---

<LayoutMW26 title="Inscripción Oficial de Equipos — Marketing Week 2026">
  <!-- 1. Barra Superior con Fechas y Contexto -->
  <TopBar />

  <!-- 2. Header de Navegación dedicado para la página de registro -->
  <header class="reg-page-nav">
    <div class="wrap reg-nav__in">
      <a class="logo reg-logo" href="/" title="Marketing Week 2026">
        <img src="/img/logo-mw26.png" width="34" height="34" alt="Logo oficial Marketing Week 2026" class="logo__emblem" />
        <span class="reg-logo-text">Marketing <i><b>Week</b></i></span>
      </a>

      <div class="reg-nav__right">
        <a href="/" class="btn btn--ghost btn--sm reg-nav-back">
          <span class="back-arrow">&larr;</span>
          <span class="back-text-full">Volver a la página principal</span>
          <span class="back-text-short">Inicio</span>
        </a>
      </div>
    </div>
  </header>

  <main class="reg-page-main">
    <div class="wrap">
      <!-- Encabezado de la página de registro -->
      <div class="reg-header-box">
        <div class="reg-badges">
          <span class="badge-rubberhose">★ CONVOCATORIA OFICIAL UNIVALLE ★</span>
          <span class="reg-pill-database">● REGISTRO OFICIAL EN VIVO</span>
        </div>

        <h1 class="reg-page-title">
          CONSIGUE EL <span class="highlight-orange">DORSAL</span> DE TU EQUIPO
        </h1>

        <p class="reg-page-lead">
          Completa el formulario oficial para inscribir a tu grupo en las competencias de Marketing Week 2026.
          Al enviar tus datos, tu escuadra se registrará en la base de datos oficial, se asignará tu número de dorsal,
          se generará tu código QR de votación popular y se descargará automáticamente tu afiche en PDF.
        </p>

        <!-- Indicador de pasos visual -->
        <div class="reg-steps-grid">
          <div class="reg-step-card">
            <span class="step-num">01</span>
            <div>
              <strong>Registra tu grupo</strong>
              <small>Nombre, líder y correo institucional</small>
            </div>
          </div>
          <div class="reg-step-card">
            <span class="step-num">02</span>
            <div>
              <strong>Elige competencias</strong>
              <small>Botargas, Stands y Embanderamiento</small>
            </div>
          </div>
          <div class="reg-step-card">
            <span class="step-num">03</span>
            <div>
              <strong>Recibe tu dorsal y QR</strong>
              <small>Descarga afiche PDF y comparte link</small>
            </div>
          </div>
        </div>
      </div>

      <!-- Contenedor del Formulario y el Dorsal en Vivo -->
      <div class="reg-workspace">
        <!-- Formulario de Registro -->
        <div class="reg-form-card">
          <div class="form-card-head">
            <h2 class="form-card-title">Ficha de Inscripción</h2>
            <p class="form-card-sub">Completa los datos oficiales de tu grupo</p>
          </div>

          <form class="form" id="regForm" novalidate>
            <div class="f2">
              <div class="field">
                <label for="gName">Nombre del grupo / equipo *</label>
                <input class="input" id="gName" type="text" autocomplete="off" placeholder="Ej. Los Pixelados" required maxlength="60" />
                <p class="err" id="eName" role="alert"></p>
              </div>
              <div class="field">
                <label for="gLeader">Líder / representante *</label>
                <input class="input" id="gLeader" type="text" autocomplete="name" placeholder="Nombre y apellido" required maxlength="80" />
                <p class="err" id="eLeader" role="alert"></p>
              </div>
            </div>

            <div class="f2">
              <div class="field">
                <label for="gEmail">Correo institucional del líder *</label>
                <input 
                  class="input" 
                  id="gEmail" 
                  type="email" 
                  inputmode="email" 
                  autocomplete="email" 
                  placeholder="xxx3005567@est.univalle.edu" 
                  required 
                />
                <p class="hint mono" style="font-size: 0.74rem; opacity: 0.85;">
                  🔒 7 dígitos antes del @ (ej. <code>xxx3005567@est.univalle.edu</code> o <code>@univalle.edu</code>)
                </p>
                <p class="err" id="eEmail" role="alert"></p>
              </div>
              <div class="field">
                <span class="lab" id="lMembers">Número de integrantes</span>
                <div class="stepper">
                  <button type="button" id="mMinus" aria-label="Quitar un integrante">−</button>
                  <input class="input" id="gMembers" type="number" min="1" max="30" value="5" aria-labelledby="lMembers" />
                  <button type="button" id="mPlus" aria-label="Agregar un integrante">+</button>
                </div>
                <p class="err" id="eMembers" role="alert"></p>
              </div>
            </div>

            <div class="field">
              <span class="lab">Competencias en las que participan</span>
              <div class="comps">
                <label class="comp is-lock" style="pointer-events: none; cursor: default;">
                  <input type="checkbox" id="c_bot" data-n="Carrera de botargas" checked disabled />
                  <span>Carrera de botargas<small>Votación popular oficial</small></span>
                </label>
                <label class="comp is-lock" style="pointer-events: none; cursor: default;">
                  <input type="checkbox" id="c_sta" data-n="Decoración de stands" checked disabled />
                  <span>Decoración de stands<small>Votación popular oficial</small></span>
                </label>
                <label class="comp comp--optional span-2">
                  <input type="checkbox" id="c_ban" data-n="Enbanderamiento" />
                  <span>Enbanderamiento<small>Votación popular · Opcional</small></span>
                </label>
              </div>
              <p class="hint" style="margin-top: 6px;">* Carrera de botargas y Decoración de stands forman parte de la inscripción oficial. Enbanderamiento es opcional.</p>
            </div>

            <!-- Alerta de Error Dinámica -->
            <div id="formErrorAlert" class="alert-box error" style="display:none;" role="alert"></div>

            <div class="foot-row" style="margin-top: 8px;">
              <button class="btn btn--orange btn--lg" type="submit" id="submitBtn" style="width: 100%; justify-content: center;">
                Inscribir equipo y generar QR oficial
              </button>
            </div>
          </form>
        </div>

        <!-- Previsualización del Dorsal Deportivo en Vivo -->
        <aside class="bib-sticky-wrapper">
          <div class="bib" id="bib" aria-live="polite">
            <!-- Tarjeta Mascota con Dorsal Oficial 01 -->
            <div class="bib-mascot-head">
              <img src="/assets/img/marki-valle-dorsal.jpg" alt="Marki Valle portando el dorsal 01" class="bib-mascot-art" />
              <div class="bib-mascot-badge-box">
                <span class="badge-rubberhose" style="font-size: 10px; padding: 2px 8px;">★ DORSAL DE CARRERA ★</span>
                <b class="font-cartoon" style="font-size: 1.05rem; color: var(--ink); display: block; margin-top: 2px;">¡COMPITE CON TU GRUPO!</b>
                <small style="font-size: 0.76rem; color: #331A00; display: block;">Visualiza en tiempo real cómo lucirá tu dorsal oficial.</small>
              </div>
            </div>

            <div class="bib__top">
              <i class="bib__hole l"></i>
              <i class="bib__hole r"></i>
              <span>Marketing Week 26</span>
            </div>

            <div class="bib__num" id="bNum">N° ---</div>
            <h3 id="bName">Tu grupo</h3>

            <dl>
              <div>
                <dt>Líder</dt>
                <dd id="bLeader">Por completar</dd>
              </div>
              <div>
                <dt>Correo</dt>
                <dd id="bEmail">Por completar</dd>
              </div>
              <div>
                <dt>Integrantes</dt>
                <dd id="bMembers">5</dd>
              </div>
              <div class="bib-comps-row">
                <dt>Compiten en</dt>
                <dd><div class="pills" id="bComps"></div></dd>
              </div>
            </dl>

            <div class="bib__qr">
              <div class="box" id="bQr">El QR se genera al inscribir</div>
              <p id="bNote">Así se verá el dorsal de tu equipo. Se actualiza automáticamente mientras escribes.</p>
            </div>

            <!-- Botón de Acción tras registro exitoso -->
            <div class="bib__actions" id="bActions" style="display:none;">
              <button class="bib-download-btn" type="button" id="bDownloadPdf">
                <span>📥 DESCARGAR FICHA DE PDF</span>
                <span class="btn-arrow">&rarr;</span>
              </button>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </main>

  <!-- Modal de Éxito y Confirmación de Registro -->
  <div id="teamSuccessModal" class="modal-backdrop" style="display:none;" role="dialog" aria-modal="true" aria-labelledby="modalTitle">
    <div class="modal-card">
      <!-- Barra superior de campeonato -->
      <div class="modal-top-bar">
        <div class="modal-top-left">
          <span class="badge-rubberhose" style="font-size: 10px; padding: 2px 10px;">★ REGISTRO OFICIAL ★</span>
          <span class="modal-chip-mw mono">MW26</span>
        </div>
        <button type="button" id="closeModalCrossBtn" class="modal-close-btn" aria-label="Cerrar ventana">&times;</button>
      </div>

      <div class="modal-body-wrapper">
        <!-- Hero con Mascota Oficial Marki Valle -->
        <div class="modal-mascot-hero">
          <div class="modal-avatar-frame">
            <img src="/assets/img/marki-valle-official.png" alt="Marki Valle Mascota Oficial MW26" class="modal-avatar-pic" />
            <span class="modal-avatar-badge">OFICIAL</span>
          </div>
          <div class="modal-hero-heading-box">
            <h3 id="modalTitle" class="modal-heading-text font-cartoon">¡EQUIPO REGISTRADO!</h3>
            <p class="modal-sub-text">Tu dorsal oficial ya fue emitido y tu grupo está listo para competir.</p>
          </div>
        </div>

        <!-- Tarjeta Balanceada: Resumen de Equipo + QR de Votación -->
        <div class="modal-card-grid">
          <!-- Columna: Datos del equipo -->
          <div class="modal-team-box">
            <div class="modal-dorsal-chip-row">
              <span class="modal-tag-label">DORSAL ASIGNADO</span>
              <span class="modal-dorsal-tag mono" id="modalTeamNum">N° 01</span>
            </div>

            <div class="modal-team-title" id="modalTeamName">-</div>

            <div class="modal-meta-rows">
              <div class="modal-meta-item">
                <span class="meta-label-k">REPRESENTANTE:</span>
                <strong class="meta-val-v" id="modalTeamLeader">-</strong>
              </div>
              <div class="modal-meta-item">
                <span class="meta-label-k">COMPETENCIAS:</span>
                <span class="meta-val-v" id="modalTeamCats">-</span>
              </div>
            </div>
          </div>

          <!-- Columna: QR Compacto -->
          <div class="modal-qr-box">
            <div class="modal-qr-border">
              <img id="modalQrImage" src="" alt="QR Oficial de Votación" width="118" height="118" />
            </div>
            <span class="modal-qr-label mono">QR OFICIAL</span>
          </div>
        </div>

        <!-- Aviso automático de descarga de PDF -->
        <div class="modal-pdf-download-note">
          <span class="pdf-note-icon">📥</span>
          <div>
            <strong>¡Tu afiche oficial en PDF se descargó automáticamente!</strong>
            <p>Contiene tu dorsal y QR listo para imprimir y colgar en tu stand.</p>
          </div>
        </div>

        <!-- ÚNICOS DOS BOTONES SOLICITADOS -->
        <div class="modal-buttons-group">
          <button type="button" id="modalReDownloadBtn" class="btn btn--orange modal-btn-primary">
            📥 Descargar ficha de PDF nuevamente
          </button>
          <button type="button" id="closeModalBtn" class="btn modal-btn-secondary">
            Entendido, ver mi dorsal
          </button>
        </div>
      </div>
    </div>
  </div>
</LayoutMW26>

<style>
  /* Header de Navegación específico de la página de registro */
  .reg-page-nav {
    border-bottom: 1px solid var(--line, rgba(16,16,16,0.14));
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--white, #FEFFFA);
    color: var(--ink, #101010);
  }

  .reg-nav__in {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    padding-block: 12px;
    min-height: 58px;
  }

  .reg-logo {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 1;
    min-width: 0;
    text-decoration: none;
    color: var(--ink, #101010);
  }

  .reg-logo-text {
    white-space: nowrap;
    overflow: hidden;
  }

  .reg-nav__right {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
  }

  .reg-nav-back {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    white-space: nowrap;
  }

  .back-text-short {
    display: none;
  }

  @media (max-width: 640px) {
    .reg-nav__in {
      padding-block: 8px;
      gap: 8px;
      min-height: 50px;
    }

    .reg-logo {
      font-size: 1.15rem;
      gap: 6px;
    }

    .reg-logo img {
      width: 28px;
      height: 28px;
    }

    .reg-logo-text {
      font-size: 1.05rem;
    }

    .back-text-full {
      display: none;
    }

    .back-text-short {
      display: inline;
    }

    .reg-nav-back {
      padding: 6px 10px !important;
      font-size: 0.72rem !important;
      letter-spacing: 0.06em !important;
    }

    .reg-nav__right {
      gap: 6px;
    }

    .reg-theme-btn {
      width: 36px;
      height: 36px;
      flex-shrink: 0;
    }
  }

  @media (max-width: 380px) {
    .reg-logo-text {
      font-size: 0.92rem;
    }
    .reg-nav-back {
      padding: 5px 8px !important;
      font-size: 0.68rem !important;
    }
  }

  /* Sección Principal */
  .reg-page-main {
    padding-top: clamp(32px, 4.5vw, 64px);
    padding-bottom: clamp(64px, 8vw, 120px);
    background: var(--paper, #F4F3EF);
  }

  /* Cabecera de la página */
  .reg-header-box {
    margin-bottom: clamp(32px, 4.5vw, 56px);
  }

  .reg-badges {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 12px;
  }

  .reg-pill-database {
    font-family: var(--f-mono, monospace);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: #0E7C3A;
    background: rgba(14, 124, 58, 0.12);
    border: 1px solid rgba(14, 124, 58, 0.35);
    padding: 3px 10px;
    border-radius: 4px;
  }

  .reg-page-title {
    font-family: var(--f-display, sans-serif);
    font-size: clamp(2.4rem, 5vw, 4.4rem);
    line-height: 0.95;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    margin: 0 0 16px;
    color: var(--ink, var(--ink));
  }

  .highlight-orange {
    color: var(--orange, var(--orange));
  }

  .reg-page-lead {
    font-size: clamp(1rem, 1.2vw, 1.15rem);
    line-height: 1.6;
    color: var(--ink, var(--ink));
    opacity: 0.85;
    max-width: 820px;
    margin: 0 0 24px;
  }

  /* Steps card grid */
  .reg-steps-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    margin-top: 20px;
  }

  @media (max-width: 840px) {
    .reg-steps-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .reg-step-card {
    background: var(--surface, #FFFFFF);
    border: 2px solid var(--ink, var(--ink));
    border-radius: 8px;
    padding: 14px 18px;
    display: flex;
    align-items: center;
    gap: 14px;
    box-shadow: 4px 4px 0px var(--ink, var(--ink));
  }

  .step-num {
    font-family: var(--f-mono, monospace);
    font-size: 1.4rem;
    font-weight: 900;
    color: var(--orange, var(--orange));
    line-height: 1;
  }

  .reg-step-card strong {
    display: block;
    font-size: 0.92rem;
    text-transform: uppercase;
    color: var(--ink, var(--ink));
  }

  .reg-step-card small {
    display: block;
    font-size: 0.76rem;
    color: var(--muted, #666);
    margin-top: 2px;
  }

  /* Layout Form + Bib */
  .reg-workspace {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(340px, 0.85fr);
    gap: clamp(28px, 4vw, 56px);
    align-items: start;
  }

  @media (max-width: 960px) {
    .reg-workspace {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .reg-form-card {
    background: var(--surface, #FFFFFF);
    border: 3px solid var(--ink, var(--ink));
    border-radius: 12px;
    box-shadow: 8px 8px 0px var(--ink, var(--ink));
    padding: clamp(24px, 3.5vw, 40px);
  }

  .form-card-head {
    margin-bottom: 24px;
    padding-bottom: 16px;
    border-bottom: 2px solid var(--rule, rgba(13,14,16,0.15));
  }

  .form-card-title {
    font-family: var(--f-display, sans-serif);
    font-size: 2rem;
    line-height: 1;
    font-weight: 900;
    text-transform: uppercase;
    margin: 0;
    color: var(--ink, var(--ink));
  }

  .form-card-sub {
    font-family: var(--f-mono, monospace);
    font-size: 0.78rem;
    color: var(--muted, #666);
    margin: 6px 0 0;
  }

  /* Sticky Wrapper para el Dorsal */
  .bib-sticky-wrapper {
    position: sticky;
    top: 90px;
  }

  @media (max-width: 960px) {
    .bib-sticky-wrapper {
      position: static;
    }
  }

  /* Estilo responsivo y fluido para las etiquetas de competencias en el dorsal naranja */
  .bib dl div.bib-comps-row {
    display: grid;
    grid-template-columns: 88px minmax(0, 1fr);
    gap: 10px;
    align-items: flex-start;
  }

  .bib .pills {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    width: 100%;
  }

  .bib .pills .tag,
  .bib .tag {
    display: inline-flex !important;
    align-items: center;
    white-space: normal !important;
    word-break: break-word;
    overflow-wrap: break-word;
    text-wrap: pretty;
    max-width: 100%;
    width: auto;
    background: var(--ink) !important;
    color: #F4F3EF !important;
    border: 1.5px solid var(--ink);
    border-radius: 4px;
    padding: 3px 8px;
    font-family: var(--f-mono, monospace);
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    line-height: 1.25;
    text-transform: uppercase;
    box-shadow: 1px 1px 0px rgba(0, 0, 0, 0.25);
  }

  @media (max-width: 480px) {
    .bib dl div.bib-comps-row {
      grid-template-columns: minmax(0, 1fr);
      gap: 6px;
    }
  }

  /* Botón de descarga en el dorsal naranja */
  .bib__actions {
    margin: 16px 20px 8px;
    box-sizing: border-box;
  }

  .bib-download-btn {
    width: 100%;
    min-height: 48px;
    padding: 12px 18px;
    background: var(--ink);
    color: #F4F3EF;
    border: 2px solid var(--ink);
    border-radius: 8px;
    font-family: var(--f-mono, monospace);
    font-size: 0.74rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    box-shadow: 3px 3px 0px rgba(13, 14, 16, 0.4);
    transition: transform 0.15s ease, background 0.15s ease, color 0.15s ease, box-shadow 0.15s ease;
    box-sizing: border-box;
  }

  .bib-download-btn:hover {
    background: #FFFFFF;
    color: var(--ink);
    border-color: var(--ink);
    transform: translate(-1px, -1px);
    box-shadow: 4px 4px 0px var(--ink);
  }

  .bib-download-btn .btn-arrow {
    font-size: 1rem;
    transition: transform 0.2s ease;
  }

  .bib-download-btn:hover .btn-arrow {
    transform: translateX(4px);
  }

  .comp.span-2 {
    grid-column: 1 / -1;
  }

  .alert-box {
    padding: 12px 16px;
    border-radius: 6px;
    font-family: var(--f-mono, monospace);
    font-size: 0.8rem;
    line-height: 1.4;
  }

  .alert-box.error {
    background: #FFE5E5;
    border: 2px solid #D32F2F;
    color: #B71C1C;
  }


  /* Modal de confirmación estilizado y optimizado */
  .modal-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(13, 14, 16, 0.85);
    backdrop-filter: blur(6px);
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(12px, 3vw, 24px);
    animation: modalFadeIn 0.2s ease-out;
  }

  @keyframes modalFadeIn {
    from { opacity: 0; transform: scale(0.98); }
    to { opacity: 1; transform: scale(1); }
  }

  .modal-card {
    background: var(--paper, #F4F3EF);
    color: var(--ink);
    border: 3.5px solid var(--ink);
    border-radius: 16px;
    box-shadow: 8px 8px 0px var(--orange, var(--orange));
    max-width: 560px;
    width: 100%;
    max-height: 92vh;
    overflow-y: auto;
    position: relative;
    display: flex;
    flex-direction: column;
  }

  .modal-top-bar {
    background: var(--ink);
    color: #F4F3EF;
    padding: 10px 16px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 2.5px solid var(--ink);
  }

  .modal-top-left {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .modal-chip-mw {
    font-size: 0.65rem;
    font-weight: 800;
    color: var(--orange, var(--orange));
    letter-spacing: 0.1em;
  }

  .modal-close-btn {
    background: none;
    border: none;
    font-size: 26px;
    line-height: 1;
    cursor: pointer;
    color: #F4F3EF;
    padding: 0 4px;
    opacity: 0.8;
