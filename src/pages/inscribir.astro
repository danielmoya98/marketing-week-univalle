    box-shadow: 4px 4px 0px var(--orange, var(--orange));
  }
</style>

<script>
  import confetti from 'canvas-confetti';
  import QRCode from 'qrcode';
  import { jsPDF } from 'jspdf';
  import { supabase, isConfigured, isValidUnivalleEmail, FALLBACK_CATEGORIAS } from '../lib/supabase.js';


  const esc = (t: string) => String(t).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c] || c));

  const regForm = document.getElementById('regForm') as HTMLFormElement | null;
  const F = {
    name: document.getElementById('gName') as HTMLInputElement,
    leader: document.getElementById('gLeader') as HTMLInputElement,
    email: document.getElementById('gEmail') as HTMLInputElement,
    members: document.getElementById('gMembers') as HTMLInputElement
  };

  const formErrorAlert = document.getElementById('formErrorAlert');
  const submitBtn = document.getElementById('submitBtn') as HTMLButtonElement | null;

  // Modal Elements
  const modal = document.getElementById('teamSuccessModal') as HTMLElement | null;
  const modalTeamName = document.getElementById('modalTeamName');
  const modalTeamNum = document.getElementById('modalTeamNum');
  const modalTeamLeader = document.getElementById('modalTeamLeader');
  const modalTeamCats = document.getElementById('modalTeamCats');
  const modalQrImage = document.getElementById('modalQrImage') as HTMLImageElement | null;
  const modalDirectVoteLink = document.getElementById('modalDirectVoteLink') as HTMLAnchorElement | null;
  const closeModalBtn = document.getElementById('closeModalBtn');
  const closeModalCrossBtn = document.getElementById('closeModalCrossBtn');
  const modalReDownloadBtn = document.getElementById('modalReDownloadBtn');
  const modalCopyLinkBtn = document.getElementById('modalCopyLinkBtn');

  let submitted = false;
  let currentTeamData: {
    id: string;
    nombre: string;
    lider: string;
    correo: string;
    integrantes: number;
    categorias: string[];
    qrDataUrl: string;
    voteUrl: string;
    num: string;
  } | null = null;

  function comps(): { id: string; name: string }[] {
    const list = [
      { id: 'botargas', k: 'bot', name: 'Carrera de botargas' },
      { id: 'stands', k: 'sta', name: 'Decoración de stands' },
      { id: 'enbanderamiento', k: 'ban', name: 'Enbanderamiento' }
    ];

    return list.filter(item => {
      const el = document.getElementById('c_' + item.k) as HTMLInputElement | null;
      return el && el.checked;
    }).map(item => ({ id: item.id, name: item.name }));
  }

  function getCategoryNamesText(catIds: string[]): string {
    return catIds.map(id => {
      const found = FALLBACK_CATEGORIAS.find(c => c.id === id);
      return found ? found.nombre : id;
    }).join(', ');
  }

  function updateBib() {
    if (submitted) return;
    const bName = document.getElementById('bName');
    const bLeader = document.getElementById('bLeader');
    const bEmail = document.getElementById('bEmail');
    const bMembers = document.getElementById('bMembers');
    const bComps = document.getElementById('bComps');

    if (bName) bName.textContent = F.name?.value.trim() || 'Tu grupo';
    if (bLeader) bLeader.textContent = F.leader?.value.trim() || 'Por completar';
    if (bEmail) bEmail.textContent = F.email?.value.trim() || 'Por completar';
    if (bMembers) bMembers.textContent = F.members?.value || '5';
    if (bComps) {
      bComps.innerHTML = comps().map(c => `<span class="tag">${esc(c.name)}</span>`).join('');
    }
  }

  if (F.name && F.leader && F.email && F.members) {
    Object.values(F).forEach(input => {
      input.addEventListener('input', () => {
        input.removeAttribute('aria-invalid');
        if (formErrorAlert) formErrorAlert.style.display = 'none';
        updateBib();
      });
    });

    document.querySelectorAll('.comp input').forEach(c => {
      c.addEventListener('change', updateBib);
    });

    const mMinus = document.getElementById('mMinus');
    const mPlus = document.getElementById('mPlus');

    if (mMinus) {
      mMinus.addEventListener('click', () => {
        F.members.value = String(Math.max(1, (+F.members.value || 1) - 1));
        updateBib();
      });
    }

    if (mPlus) {
      mPlus.addEventListener('click', () => {
        F.members.value = String(Math.min(30, (+F.members.value || 0) + 1));
        updateBib();
      });
    }

    updateBib();
  }

  function setErr(id: string, input: HTMLInputElement, msg: string): boolean {
    const el = document.getElementById(id);
    if (el) el.textContent = msg;
    if (msg) input.setAttribute('aria-invalid', 'true');
    else input.removeAttribute('aria-invalid');
    return !msg;
  }

  // Helper para cargar imágenes en el navegador antes de agregarlas a jsPDF
  function loadImage(url: string): Promise<HTMLImageElement | null> {
    return new Promise((resolve) => {
      const img = new Image();
      img.crossOrigin = 'anonymous';
      img.onload = () => resolve(img);
      img.onerror = () => resolve(null);
      img.src = url;
    });
  }

  // Generador oficial del PDF en formato afiche A4 con estética Streetwear / Brutalista
  async function generateAndDownloadTeamPdf(team: NonNullable<typeof currentTeamData>) {
    try {
      const doc = new jsPDF({
        orientation: 'portrait',
        unit: 'mm',
        format: 'a4'
      });

      const pw = doc.internal.pageSize.getWidth(); // 210mm
      const ph = doc.internal.pageSize.getHeight(); // 297mm

      // Cargar imagen oficial del Logo en paralelo
      const [logoImg] = await Promise.all([
        loadImage('/img/logo-mw26.png')
      ]);

      // 1. Fondo de papel editorial marfil cálido
      doc.setFillColor(244, 243, 239);
      doc.rect(0, 0, pw, ph, 'F');

      // 2. Borde exterior deportivo / streetwear de 2mm
      doc.setDrawColor(13, 14, 16);
      doc.setLineWidth(2);
      doc.rect(10, 10, pw - 20, ph - 20);

      // Borde interior fino
      doc.setLineWidth(0.6);
      doc.rect(13, 13, pw - 26, ph - 26);

      // 3. Orificios de perforación de dorsal deportivo (esquinas superiores)
      doc.setFillColor(255, 255, 255);
      doc.setDrawColor(13, 14, 16);
      doc.setLineWidth(1);
      doc.circle(20, 20, 3.5, 'FD');
      doc.circle(pw - 20, 20, 3.5, 'FD');

      // 4. Franja de Cabecera de Campeonato Naranja
      doc.setFillColor(255, 122, 0);
      doc.rect(13.6, 13.6, pw - 27.2, 24, 'F');
      doc.setDrawColor(13, 14, 16);
      doc.setLineWidth(1.5);
      doc.line(13, 38, pw - 13, 38);

      // Logo MW26 en cabecera
      if (logoImg) {
        try {
          doc.addImage(logoImg, 'PNG', 18, 16, 19, 19);
        } catch (e) {}
      }

      // Título en cabecera
      doc.setFont('helvetica', 'bold');
      doc.setFontSize(16);
      doc.setTextColor(13, 14, 16);
      doc.text('MARKETING WEEK 2026', 42, 25);

      doc.setFont('helvetica', 'bold');
      doc.setFontSize(8.5);
      doc.setTextColor(30, 15, 0);
      doc.text('UNIVALLE CAMPUS CENTRAL · FICHA OFICIAL DE DORSAL', 42, 32);

      // Insignia derecha en cabecera
      doc.setFillColor(13, 14, 16);
      doc.rect(pw - 58, 19, 41, 13, 'F');
      doc.setTextColor(255, 122, 0);
      doc.setFontSize(8);
      doc.setFont('helvetica', 'bold');
      doc.text('DORSAL OFICIAL', pw - 37.5, 27.5, { align: 'center' });

      // 5. Número de Dorsal Gigante de Campeonato
      doc.setFont('helvetica', 'bold');
      doc.setFontSize(54);
      doc.setTextColor(13, 14, 16);
      doc.text(`N° ${team.num}`, pw / 2, 60, { align: 'center' });

      // Subtítulo dorsal
      doc.setFont('helvetica', 'bold');
      doc.setFontSize(8.5);
      doc.setTextColor(120, 50, 0);
      doc.text('★ IDENTIFICADOR OFICIAL DE CARRERA Y STAND ★', pw / 2, 66, { align: 'center' });

      // 6. Tarjeta de Datos del Equipo con Sombra Neo-Brutalista
      const cardX = 18;
      const cardY = 70;
      const cardW = pw - 36;
      const cardH = 44;

      // Sombra dura naranja
      doc.setFillColor(255, 122, 0);
      doc.rect(cardX + 2, cardY + 2, cardW, cardH, 'F');

      // Tarjeta blanca superior
      doc.setFillColor(255, 255, 255);
      doc.setDrawColor(13, 14, 16);
      doc.setLineWidth(1.5);
      doc.rect(cardX, cardY, cardW, cardH, 'FD');

      // Nombre del equipo
      doc.setFont('helvetica', 'bold');
      doc.setFontSize(22);
      doc.setTextColor(255, 122, 0);
      doc.text(team.nombre.toUpperCase(), pw / 2, cardY + 12, { align: 'center' });

      // Línea divisoria
      doc.setDrawColor(220, 220, 220);
      doc.setLineWidth(0.6);
      doc.line(cardX + 8, cardY + 16, cardX + cardW - 8, cardY + 16);

      // Metadatos
      doc.setFont('helvetica', 'normal');
      doc.setFontSize(10);
      doc.setTextColor(70, 70, 70);
      doc.text('Representante:', cardX + 8, cardY + 24);
      doc.setFont('helvetica', 'bold');
      doc.setTextColor(13, 14, 16);
      doc.text(team.lider, cardX + 42, cardY + 24);

      doc.setFont('helvetica', 'normal');
      doc.setTextColor(70, 70, 70);
      doc.text('Integrantes:', cardX + cardW - 48, cardY + 24);
      doc.setFont('helvetica', 'bold');
      doc.setTextColor(13, 14, 16);
      doc.text(String(team.integrantes), cardX + cardW - 20, cardY + 24);

      doc.setFont('helvetica', 'normal');
      doc.setTextColor(70, 70, 70);
      doc.text('Correo del líder:', cardX + 8, cardY + 31);
      doc.setFont('courier', 'bold');
      doc.setTextColor(13, 14, 16);
      doc.text(team.correo, cardX + 42, cardY + 31);

      // Competencias
      const catText = team.categorias.join(' · ');
      doc.setFont('helvetica', 'bold');
      doc.setFontSize(9);
      doc.setTextColor(255, 122, 0);
      doc.text(`COMPITE EN: ${catText.toUpperCase()}`, pw / 2, cardY + 39, { align: 'center' });

      // 7. Zona Central del Código QR (centrado)
      const qrSize = 82;
      const qrX = (pw - qrSize) / 2;
      const qrY = 124;

      // Sombra dura del marco QR
      doc.setFillColor(255, 122, 0);
      doc.rect(qrX - 1.5, qrY - 1.5, qrSize + 7, qrSize + 7, 'F');

      // Marco blanco del QR
      doc.setFillColor(255, 255, 255);
      doc.setDrawColor(13, 14, 16);
      doc.setLineWidth(1.6);
      doc.rect(qrX - 3.5, qrY - 3.5, qrSize + 7, qrSize + 7, 'FD');

      // Imagen QR
      doc.addImage(team.qrDataUrl, 'PNG', qrX, qrY, qrSize, qrSize);

      // 8. Llamada a la Acción Limpia (Sin localhost, sin caracteres rotos)
      doc.setFont('helvetica', 'bold');
      doc.setFontSize(18);
      doc.setTextColor(255, 122, 0);
      doc.text('ESCANEA EL CODIGO PARA VOTAR', pw / 2, qrY + qrSize + 14, { align: 'center' });

      doc.setFont('helvetica', 'normal');
      doc.setFontSize(10.5);
      doc.setTextColor(40, 40, 40);
      doc.text('Abre la camara de tu celular para apoyar a este equipo en Marketing Week.', pw / 2, qrY + qrSize + 21, { align: 'center' });

      // 9. Franja Inferior Oficial de Campeonato
      const footH = 26;
      const footY = ph - 13 - footH;

      doc.setFillColor(13, 14, 16);
      doc.rect(13.6, footY, pw - 27.2, footH, 'F');
      doc.setDrawColor(255, 122, 0);
      doc.setLineWidth(1.2);
      doc.line(13, footY, pw - 13, footY);

      doc.setFont('helvetica', 'bold');
      doc.setFontSize(9.5);
      doc.setTextColor(255, 122, 0);
      doc.text('UNIVALLE · MARKETING WEEK 2026 · CAMPUS CENTRAL', pw / 2, footY + 9, { align: 'center' });

      doc.setFont('helvetica', 'normal');
      doc.setFontSize(7.5);
      doc.setTextColor(244, 243, 239);
      doc.text('Votacion oficial abierta para toda la comunidad universitaria con correo institucional.', pw / 2, footY + 16, { align: 'center' });
      doc.text('Coloca este afiche en tu stand o compartelo con tu grupo para recibir votos.', pw / 2, footY + 22, { align: 'center' });

      const safeName = team.nombre.replace(/[^a-zA-Z0-9_-]/g, '_');
      doc.save(`Ficha-Dorsal-${safeName}-MW26.pdf`);
    } catch (err) {
      console.error('Error generando PDF del dorsal:', err);
    }
  }

  // Envío del Formulario
  if (regForm) {
    regForm.addEventListener('submit', async (e: Event) => {
      e.preventDefault();
      if (formErrorAlert) formErrorAlert.style.display = 'none';

      const nombre = F.name.value.trim();
      const lider = F.leader.value.trim();
      const emailVal = F.email.value.trim().toLowerCase();
      const m = +F.members.value;

      const a = setErr('eName', F.name, nombre.length < 2 ? 'Escribe el nombre del grupo.' : '');
      const b = setErr('eLeader', F.leader, lider.length < 3 ? 'Escribe nombre y apellido del representante.' : '');
      const emailOk = isValidUnivalleEmail(emailVal);
      const c = setErr('eEmail', F.email, emailOk ? '' : 'Debe tener exactamente 7 números antes del @ y terminar en @est.univalle.edu o @univalle.edu (ej. xxx3005567@est.univalle.edu)');
      const d = setErr('eMembers', F.members, (m >= 1 && m <= 30) ? '' : 'Indica entre 1 y 30 integrantes.');

      if (!(a && b && c && d)) {
        if (!emailOk && formErrorAlert) {
          formErrorAlert.textContent = '⚠️ Formato de correo institucional inválido. Debe tener exactamente 7 números antes del @ (ej. xxx3005567@est.univalle.edu o xxx3005567@univalle.edu)';
          formErrorAlert.style.display = 'block';
        }
        const firstErr = regForm.querySelector('[aria-invalid="true"]') as HTMLElement | null;
        if (firstErr) firstErr.focus();
        return;
      }

      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Inscribiendo equipo en vivo...';
      }

      const selectedComps = comps();
      const compIds = selectedComps.map(x => x.id);
      const compNames = selectedComps.map(x => x.name);
      // 1. Cálculo correlativo del número de dorsal oficial (01, 02, 03...)
      let teamOrder = 1;
      if (isConfigured && supabase) {
        try {
          const { count, error } = await supabase.from('grupos').select('*', { count: 'exact', head: true });
          if (!error && typeof count === 'number') {
            teamOrder = count + 1;
          }
        } catch (e) {
          console.warn('Aviso calculando número correlativo:', e);
        }
      } else {
        const savedCount = parseInt(localStorage.getItem('mw26_team_counter') || '0', 10);
        teamOrder = savedCount + 1;
        localStorage.setItem('mw26_team_counter', String(teamOrder));
      }

      const numFormatted = String(teamOrder).padStart(2, '0');
      let grupoId = '';

      try {
        if (isConfigured && supabase) {
          // Validar que el correo no esté ya registrado con otro equipo
          const { data: existingGroup, error: checkError } = await supabase
            .from('grupos')
            .select('id, nombre')
            .eq('correo_lider', emailVal)
            .maybeSingle();

          if (existingGroup) {
            throw new Error(`Este correo institucional ya tiene un equipo registrado ("${existingGroup.nombre}"). Cada líder solo puede inscribir un equipo.`);
          }

          // 2. Inserción en tabla 'grupos'
          const { data: grupoData, error: grupoError } = await supabase
            .from('grupos')
            .insert({
              nombre,
              lider,
              correo_lider: emailVal,
              integrantes: m,
              categorias: compIds,
              color: 'var(--orange)'
            })
            .select()
            .single();

          if (grupoError) {
            if (grupoError.code === '23505' || grupoError.message?.includes('duplicate key') || grupoError.message?.includes('uq_grupos_correo_lider')) {
              throw new Error('Este correo institucional ya tiene un equipo registrado. Cada líder solo puede inscribir un equipo.');
            }
            throw new Error(`Error en base de datos: ${grupoError.message}`);
          }

          grupoId = grupoData.id;

          // 3. Inserción en tabla 'equipos' para cada competencia admitida
          const validDbCats = ['botargas', 'stands', 'enbanderamiento'];
          const equiposRows = compIds
            .filter(c => validDbCats.includes(c))
            .map((cId, idx) => ({
              grupo_id: grupoId,
              categoria_id: cId,
              nombre: nombre,
              color: 'var(--orange)',
              orden: idx + 1
            }));

          if (equiposRows.length > 0) {
            const { error: equiposError } = await supabase
              .from('equipos')
              .insert(equiposRows);

            if (equiposError) {
              console.warn('Aviso insertando filas en equipos:', equiposError);
            }
          }
        } else {
          // Fallback offline / demo
          grupoId = 'demo-' + Date.now();
        }

        submitted = true;
        const baseSite = window.location.origin;
        const voteUrl = `${baseSite}/votar?equipo=${grupoId}`;

        // 4. Generar código QR
        let qrDataUrl = '';
        try {
          qrDataUrl = await QRCode.toDataURL(voteUrl, {
            width: 600,
            margin: 1.5,
            color: { dark: 'var(--ink)', light: '#FFFFFF' }
          });
        } catch (err) {
          console.error('Error generando QR:', err);
        }

        currentTeamData = {
          id: grupoId,
          nombre,
          lider,
          correo: emailVal,
          integrantes: m,
          categorias: compNames,
          qrDataUrl,
          voteUrl,
          num: numFormatted
        };

        // 5. Lanzar confeti de celebración
        try {
          confetti({
            particleCount: 85,
            spread: 75,
            origin: { y: 0.55 },
            colors: ['var(--orange)', '#F4F3EF', 'var(--ink)', '#0E7C3A']
          });
        } catch (e) {}

        // 6. Actualizar el Dorsal en la pantalla
        const box = document.getElementById('bQr');
        if (box) {
          box.innerHTML = qrDataUrl ? `<img src="${qrDataUrl}" alt="QR Oficial" style="width:110px;height:110px;display:block;margin:auto;background:#fff;padding:4px;border-radius:4px;" />` : voteUrl;
        }

        const bNum = document.getElementById('bNum');
        const bName = document.getElementById('bName');
        const bLeader = document.getElementById('bLeader');
        const bEmail = document.getElementById('bEmail');
        const bMembers = document.getElementById('bMembers');
        const bComps = document.getElementById('bComps');
        const bNote = document.getElementById('bNote');
        const bActions = document.getElementById('bActions');

        if (bNum) bNum.textContent = 'N° ' + numFormatted;
        if (bName) bName.textContent = nombre;
        if (bLeader) bLeader.textContent = lider;
        if (bEmail) bEmail.textContent = emailVal;
        if (bMembers) bMembers.textContent = String(m);
        if (bComps) bComps.innerHTML = compNames.map(x => `<span class="tag">${esc(x)}</span>`).join('');
        if (bNote) bNote.textContent = '¡Equipo inscrito y registrado con éxito!';
        if (bActions) bActions.style.display = 'block';

        // 7. Poblar datos en el modal
        if (modalTeamName) modalTeamName.textContent = nombre;
        if (modalTeamNum) modalTeamNum.textContent = `N° ${numFormatted}`;
        if (modalTeamLeader) modalTeamLeader.textContent = lider;
        if (modalTeamCats) modalTeamCats.textContent = compNames.join(', ');
        if (modalQrImage) modalQrImage.src = qrDataUrl;

        // 8. Abrir modal
        if (modal) modal.style.display = 'flex';

        // 9. Descarga automática del PDF oficial
        await generateAndDownloadTeamPdf(currentTeamData);

        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = '✓ Equipo Registrado con Éxito';
        }

      } catch (err: any) {
        console.error(err);
        if (formErrorAlert) {
          formErrorAlert.textContent = `⚠️ No se pudo registrar el equipo: ${err.message || 'Error de conexión'}`;
          formErrorAlert.style.display = 'block';
        }
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Inscribir equipo y generar QR oficial';
        }
      }
    });
  }

  // Acciones del Modal y del Dorsal
  function closeModal() {
    if (modal) modal.style.display = 'none';
  }
  closeModalBtn?.addEventListener('click', closeModal);
  closeModalCrossBtn?.addEventListener('click', closeModal);

  // Descargas manuales del PDF
  document.getElementById('bDownloadPdf')?.addEventListener('click', () => {
    if (currentTeamData) generateAndDownloadTeamPdf(currentTeamData);
  });
  modalReDownloadBtn?.addEventListener('click', () => {
    if (currentTeamData) generateAndDownloadTeamPdf(currentTeamData);
  });
</script>
